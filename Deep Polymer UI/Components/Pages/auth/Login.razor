@page "/"
@page "/login"
@layout Layout.AuthLayout
@using DeepPolymer.Constants
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="auth-page">
    <!-- Top Greeting Header -->
    <div class="auth-header-wrapper">
        <h1 class="auth-header-title">Welcome Back!</h1>
        <p class="auth-header-subtitle">Good to see you again. Enter your details to sign in.</p>
    </div>

    <!-- Auth Card Container -->
    <div class="auth-card">
        <h2 class="auth-card-title">Sign in with Email</h2>

        <form @onsubmit="HandleLogin" @onsubmit:preventDefault>
            <!-- Email Address -->
            <div class="auth-form-group">
                <label class="auth-label">
                    Email Address <span class="required-star">*</span>
                </label>
                <input class="auth-input"
                       type="email"
                       placeholder="Email Address"
                       @bind="email" />
            </div>

            <!-- Password -->
            <div class="auth-form-group">
                <label class="auth-label">
                    Password <span class="required-star">*</span>
                </label>
                <div class="auth-input-wrapper">
                    <input class="auth-input"
                           type="@(showPassword ? "text" : "password")"
                           placeholder="Password"
                           @bind="password" />
                    
                    <button type="button"
                            class="auth-password-toggle"
                            @onclick="TogglePasswordVisibility"
                            title="@(showPassword ? "Hide password" : "Show password")">
                        @if (showPassword)
                        {
                            <!-- Eye Off Icon -->
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <!-- Eye Icon -->
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <!-- Remember me -->
            <div class="auth-checkbox-row">
                <input type="checkbox" id="remember-me" class="auth-checkbox" @bind="rememberMe" />
                <label for="remember-me" class="auth-checkbox-label">Remember me</label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="auth-btn-primary">Login</button>

            <!-- Footer Link -->
            <p class="auth-footer-link">
                Forgot Password? <a href="/forgot-password" class="auth-link">Click here</a>
            </p>
        </form>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private bool showPassword = false;
    private bool rememberMe = false;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void HandleLogin()
    {
        // Navigate branch-wise (Hajipur vs Santej)
        string targetRoute = ColorConstant.IsDispatchUser
            ? "/hajipur/dispatch-user/pmr-management"
            : (ColorConstant.IsProductionHead
               ? "/hajipur/production-head/pmr-management"
               : (ColorConstant.BranchFlag == 2
                  ? "/hajipur/pmr-management"
                  : (ColorConstant.IsLabUser ? "/santej/lab-user/pmr-management"
                     : (ColorConstant.IsProductionUser ? "/santej/production-user/pmr-management" : "/santej/pmr-management"))));
            
        Navigation.NavigateTo(targetRoute);
    }
}
