@page "/forgot-password"
@layout Layout.AuthLayout
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="auth-page">
    <!-- Auth Card Container -->
    <div class="auth-card">
        <h2 class="auth-card-title">Forgot Password?</h2>

        <form @onsubmit="HandleResetPassword" @onsubmit:preventDefault>
            <!-- Email Address -->
            <div class="auth-form-group">
                <label class="auth-label">
                    Email Address <span class="required-star">*</span>
                </label>
                <input class="auth-input"
                       type="email"
                       placeholder="Email Address"
                       @bind="email" />
            </div>

            <!-- Reset Password Button -->
            <button type="submit" class="auth-btn-primary">Reset Password</button>

            <!-- Back to Sign In Link -->
            <p class="auth-footer-link">
                <a href="/login" class="auth-back-link">
                    <img src="assets/image/back_icon.svg" alt="Back" class="auth-back-icon" />
                    Back to Sign In
                </a>
            </p>
        </form>
    </div>
</div>

@code {
    private string email = "";

    private void HandleResetPassword()
    {
        // Navigate directly to reset password page
        Navigation.NavigateTo("/reset-password");
    }
}
