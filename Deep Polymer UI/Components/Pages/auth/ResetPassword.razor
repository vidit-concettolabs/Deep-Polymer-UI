@page "/reset-password"
@layout Layout.AuthLayout
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="auth-page">
    <!-- Auth Card Container -->
    <div class="auth-card">
        <h2 class="auth-card-title">Reset Password</h2>

        <form @onsubmit="HandleResetPassword" @onsubmit:preventDefault>
            <!-- New Password -->
            <div class="auth-form-group">
                <label class="auth-label">
                    New Password <span class="required-star">*</span>
                </label>
                <div class="auth-input-wrapper">
                    <input class="auth-input"
                           type="@(showNewPassword ? "text" : "password")"
                           placeholder="New Password"
                           @bind="newPassword" />
                    
                    <button type="button"
                            class="auth-password-toggle"
                            @onclick="() => showNewPassword = !showNewPassword"
                            title="@(showNewPassword ? "Hide password" : "Show password")">
                        @if (showNewPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <!-- Confirm Password -->
            <div class="auth-form-group" style="margin-bottom: 24px;">
                <label class="auth-label">
                    Confirm Password <span class="required-star">*</span>
                </label>
                <div class="auth-input-wrapper">
                    <input class="auth-input"
                           type="@(showConfirmPassword ? "text" : "password")"
                           placeholder="Confirm Password"
                           @bind="confirmPassword" />
                    
                    <button type="button"
                            class="auth-password-toggle"
                            @onclick="() => showConfirmPassword = !showConfirmPassword"
                            title="@(showConfirmPassword ? "Hide password" : "Show password")">
                        @if (showConfirmPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="auth-btn-primary">Change Password</button>

            <!-- Footer Link -->
            <p class="auth-footer-link">
                <a href="/login" class="auth-back-link">
                    <img src="assets/image/back_icon.svg" alt="Back" class="auth-back-icon" />
                    Back to Sign In
                </a>
            </p>
        </form>
    </div>
</div>

@code {
    private string newPassword = "";
    private string confirmPassword = "";
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    private void HandleResetPassword()
    {
        // Navigate back to login after password reset
        Navigation.NavigateTo("/login");
    }
}
