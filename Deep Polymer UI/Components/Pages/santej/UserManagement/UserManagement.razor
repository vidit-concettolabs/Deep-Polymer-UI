@page "/users"

<div class="user-page">
    <!-- Page Header -->
    <div class="user-page-header">
        <div>
            <h1 class="user-page-title">User Management</h1>
            <p class="user-page-subtitle">Manage user accounts, roles, and platform access permissions.</p>
        </div>
        <button class="user-create-btn" id="btn-create-user">Create User</button>
    </div>

    <!-- Table Card -->
    <div class="user-card">
        <!-- Search Filters -->
        <div class="user-filter-row">
            <div class="user-search-wrapper">
                <select class="user-search-select" id="search-user-role">
                    <option selected disabled>Search Role</option>
                    <option>CEO</option>
                    <option>PMR Generator</option>
                    <option>Lab User</option>
                </select>
                <span class="user-search-chevron">&#8964;</span>
            </div>
            <div class="user-search-wrapper">
                <select class="user-search-select" id="search-user-name">
                    <option selected disabled>Search User Name</option>
                    <option>John Doe</option>
                    <option>Sarah Smith</option>
                    <option>Mike Johnson</option>
                </select>
                <span class="user-search-chevron">&#8964;</span>
            </div>
        </div>

        <!-- Data Table -->
        <table class="user-table">
            <thead>
                <tr>
                    <th>User Name</th>
                    <th>Role</th>
                    <th>IP Address</th>
                    <th>Created Date</th>
                    <th style="text-align:center;">Status</th>
                    <th style="text-align:center;">Bypass IP</th>
                    <th style="text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>John Doe</td>
                    <td>CEO</td>
                    <td>192.168.1.101</td>
                    <td>11-05-2026</td>
                    <td style="text-align:center;"><span class="user-status-badge active">Active</span></td>
                    <td style="text-align:center;">
                        <label class="user-toggle">
                            <input type="checkbox" checked id="bypass-user-1" />
                            <span class="user-toggle-slider"></span>
                        </label>
                    </td>
                    <td></td>
                </tr>
                <tr>
                    <td>Sarah Smith</td>
                    <td>PMR Generator</td>
                    <td>192.168.1.482</td>
                    <td>15-05-2026</td>
                    <td style="text-align:center;"><span class="user-status-badge active">Active</span></td>
                    <td style="text-align:center;">
                        <label class="user-toggle">
                            <input type="checkbox" id="bypass-user-2" />
                            <span class="user-toggle-slider"></span>
                        </label>
                    </td>
                    <td>
                        <div class="user-action-cell">
                            <button class="user-icon-btn edit" title="Edit" id="edit-user-2">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="user-icon-btn delete" title="Delete" id="delete-user-2">
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>Mike Johnson</td>
                    <td>Lab User</td>
                    <td>192.168.1.146</td>
                    <td>15-05-2026</td>
                    <td style="text-align:center;"><span class="user-status-badge active">Active</span></td>
                    <td style="text-align:center;">
                        <label class="user-toggle">
                            <input type="checkbox" checked id="bypass-user-3" />
                            <span class="user-toggle-slider"></span>
                        </label>
                    </td>
                    <td>
                        <div class="user-action-cell">
                            <button class="user-icon-btn edit" title="Edit" id="edit-user-3">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="user-icon-btn delete" title="Delete" id="delete-user-3">
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

