@page "/locations"
@rendermode InteractiveServer



<div class="locations-page">
    <!-- Page Header -->
    <div class="locations-page-header">
        <div>
            <h1 class="locations-page-title">Manage Locations</h1>
            <p class="locations-page-subtitle">Manage business locations used across PMR workflows and operations.</p>
        </div>
        <button class="locations-add-btn" id="btn-add-location" @onclick="() => showAddDialog = true">Add Location</button>
    </div>

    <AddLocationDialog @bind-IsOpen="showAddDialog" />

    <!-- Table Card -->
    <div class="locations-card">
        <!-- Search Filter -->
        <div class="locations-filter-row">
            <div class="locations-search-wrapper">
                <select class="locations-search-select" id="search-location">
                    <option selected disabled>Search Location</option>
                    <option>Rakanpur</option>
                    <option>Hajipur</option>
                </select>
                <span class="locations-search-chevron">&#8964;</span>
            </div>
        </div>

        <!-- Data Table -->
        <table class="locations-table">
            <thead>
                <tr>
                    <th>Location Name</th>
                    <th style="text-align:center;">Status</th>
                    <th>Created Date</th>
                    <th style="text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Rakanpur</td>
                    <td style="text-align:center;"><span class="loc-status-badge active">Active</span></td>
                    <td>11-05-2026</td>
                    <td style="text-align:center;">
                        <div class="loc-action-cell">
                            <label class="loc-toggle">
                                <input type="checkbox" checked id="toggle-loc-1" />
                                <span class="loc-toggle-slider"></span>
                            </label>
                            <button class="loc-icon-btn edit" title="Edit" id="edit-loc-1">
                                <svg viewBox="0 0 24 24">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </button>
                            <button class="loc-icon-btn delete" title="Delete" id="delete-loc-1">
                                <svg viewBox="0 0 24 24">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                    <path d="M10 11v6"/>
                                    <path d="M14 11v6"/>
                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>Hajipur</td>
                    <td style="text-align:center;"><span class="loc-status-badge active">Active</span></td>
                    <td>26-04-2026</td>
                    <td style="text-align:center;">
                        <div class="loc-action-cell">
                            <label class="loc-toggle">
                                <input type="checkbox" checked id="toggle-loc-2" />
                                <span class="loc-toggle-slider"></span>
                            </label>
                            <button class="loc-icon-btn edit" title="Edit" id="edit-loc-2">
                                <svg viewBox="0 0 24 24">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </button>
                            <button class="loc-icon-btn delete" title="Delete" id="delete-loc-2">
                                <svg viewBox="0 0 24 24">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                    <path d="M10 11v6"/>
                                    <path d="M14 11v6"/>
                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    private bool showAddDialog = false;
}
