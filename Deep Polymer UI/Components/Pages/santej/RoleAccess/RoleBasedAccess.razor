@page "/role-access"

<div class="role-page">
    <!-- Page Header -->
    <div class="role-page-header">
        <div>
            <h1 class="role-page-title">Role Based Access</h1>
            <p class="role-page-subtitle">Manage user roles and permission access across the platform.</p>
        </div>
        <button class="role-add-btn" id="btn-add-role">Add Role</button>
    </div>

    <!-- Table Card -->
    <div class="role-card">
        <!-- Search Filter -->
        <div class="role-filter-row">
            <div class="role-search-wrapper">
                <select class="role-search-select" id="search-role">
                    <option selected disabled>Search Role</option>
                    <option>CEO</option>
                    <option>PMR Generator</option>
                    <option>Lab User</option>
                </select>
                <span class="role-search-chevron">&#8964;</span>
            </div>
        </div>

        <!-- Data Table -->
        <table class="role-table">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Location</th>
                    <th style="text-align:center;">Status</th>
                    <th>Created Date</th>
                    <th style="text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>CEO</td>
                    <td>-</td>
                    <td style="text-align:center;"><span class="role-status-badge active">Active</span></td>
                    <td>11-05-2026</td>
                    <td style="text-align:center;"></td>
                </tr>
                <tr>
                    <td>PMR Generator</td>
                    <td>Rakanpur</td>
                    <td style="text-align:center;"><span class="role-status-badge active">Active</span></td>
                    <td>15-05-2026</td>
                    <td style="text-align:center;">
                        <div class="role-action-cell">
                            <label class="role-toggle">
                                <input type="checkbox" checked id="toggle-role-1" />
                                <span class="role-toggle-slider"></span>
                            </label>
                            <button class="role-icon-btn edit" title="Edit" id="edit-role-1">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="role-icon-btn delete" title="Delete" id="delete-role-1">
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>Lab User</td>
                    <td>Rakanpur</td>
                    <td style="text-align:center;"><span class="role-status-badge active">Active</span></td>
                    <td>15-05-2026</td>
                    <td style="text-align:center;">
                        <div class="role-action-cell">
                            <label class="role-toggle">
                                <input type="checkbox" checked id="toggle-role-2" />
                                <span class="role-toggle-slider"></span>
                            </label>
                            <button class="role-icon-btn edit" title="Edit" id="edit-role-2">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="role-icon-btn delete" title="Delete" id="delete-role-2">
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

