@if (IsOpen)
{
    <div class="dialog-overlay" @onclick="Close">
        <div class="dialog-card" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3 class="dialog-title">Add Denier Master</h3>
                <button class="dialog-close-btn" type="button" @onclick="Close">&times;</button>
            </div>
            <div class="dialog-body">
                <div class="dialog-form-group">
                    <label class="dialog-label">
                        Denier Master Name <span class="required-star">*</span>
                    </label>
                    <input class="dialog-input" type="text" placeholder="Denier Master Name" @bind="DenierName" />
                </div>
                <div class="dialog-form-group">
                    <label class="dialog-label">Description</label>
                    <input class="dialog-input" type="text" placeholder="Description" @bind="Description" />
                </div>
                <div class="dialog-status-wrapper">
                    <label class="dialog-label">Status</label>
                    <label class="dialog-toggle">
                        <input type="checkbox" @bind="IsActive" />
                        <span class="dialog-toggle-slider"></span>
                    </label>
                </div>
            </div>
            <div class="dialog-footer">
                <button class="dialog-cancel-btn" type="button" @onclick="Close">Cancel</button>
                <button class="dialog-submit-btn" type="button" @onclick="Submit">Submit</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    private string DenierName { get; set; } = "";
    private string Description { get; set; } = "";
    private bool IsActive { get; set; } = true;

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Submit()
    {
        await OnSubmit.InvokeAsync();
        await Close();
    }
}

