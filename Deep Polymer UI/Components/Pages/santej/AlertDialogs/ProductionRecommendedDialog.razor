@using Microsoft.AspNetCore.Components

@if (IsOpen)
{
    <div class="dialog-overlay" @onclick="Close">
        <div class="dialog-card prod-recommended-dialog" @onclick:stopPropagation>
            <!-- Dialog Header -->
            <div class="dialog-header prod-rec-header">
                <h3 class="dialog-title" style="font-size: 16px; font-weight: 700; color: #151515; margin: 0;">Recommended</h3>
                <button type="button" class="dialog-close-btn" @onclick="Close" title="Close">&times;</button>
            </div>

            <!-- Dialog Body -->
            <div class="dialog-body prod-rec-body">
                <!-- Top 3-Column Info Row -->
                <div class="prod-rec-info-grid">
                    <div class="prod-rec-info-item">
                        <span class="prod-rec-label">PMR Number</span>
                        <span class="prod-rec-value">@(string.IsNullOrEmpty(PmrNo) ? "PMR-002" : PmrNo)</span>
                    </div>
                    <div class="prod-rec-info-item">
                        <span class="prod-rec-label">Colour Name</span>
                        <span class="prod-rec-value">Ocean Blue - A</span>
                    </div>
                    <div class="prod-rec-info-item">
                        <span class="prod-rec-label">Colour Code</span>
                        <span class="prod-rec-value">OB-102</span>
                    </div>
                </div>

                <div class="prod-rec-divider"></div>

                <!-- Note Section -->
                <div class="prod-rec-note-section">
                    <span class="prod-rec-label">Note</span>
                    <p class="prod-rec-note-text">Designed for automotive finishing applications to provide durable surface protection and premium color appearance.</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string? PmrNo { get; set; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
