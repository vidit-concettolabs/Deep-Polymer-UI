@using DeepPolymer.Constants

@if (IsOpen)
{
    <div class="dialog-overlay" @onclick="Close">
        <div class="dialog-card change-rate-card" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3 class="dialog-title">Change Rate</h3>
                <button class="dialog-close-btn" type="button" @onclick="Close">&times;</button>
            </div>
            
            <div class="dialog-body cr-body">
                <div class="cr-table-wrapper">
                    <table class="cr-table">
                        <thead>
                            <tr>
                                <th style="width: 40px; text-align: center;">
                                    <input type="checkbox" class="cr-checkbox" @bind="selectAll" @bind:after="ToggleSelectAll" />
                                </th>
                                <th>Colour Name</th>
                                <th>Product Name</th>
                                <th>PMR No.</th>
                                <th>Colour Code</th>
                                <th>Price (Selling Price)</th>
                                <th>New Price(Selling Price)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in rateItems)
                            {
                                <tr>
                                    <td style="text-align: center;">
                                        <input type="checkbox" class="cr-checkbox" @bind="item.IsSelected" @bind:after="OnItemChanged" />
                                    </td>
                                    <td>@item.ColourName</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.PmrNo</td>
                                    <td>@item.ColourCode</td>
                                    <td>@item.Price</td>
                                    <td>
                                        <input type="text" class="cr-input" placeholder="Enter" @bind="item.NewPrice" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Bottom Right New Price (%) field -->
                <div class="cr-percent-wrapper">
                    <label class="dialog-label">
                        New Price(%) <span class="required-star">*</span>
                    </label>
                    <input type="text" class="dialog-input cr-percent-input" placeholder="Enter percentage" @bind="newPricePercent" />
                </div>
            </div>

            <div class="dialog-footer">
                <button class="dialog-cancel-btn" type="button" @onclick="Close">Cancel</button>
                <button class="dialog-submit-btn red-btn" type="button" @onclick="Submit">Submit</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    private bool selectAll = false;
    private string newPricePercent = "";

    private List<RateItem> rateItems = new()
    {
        new RateItem { ColourName = "Ocean Blue-A", ProductName = "HD Polymer Mix", PmrNo = "PMR-001", ColourCode = "OB-102", Price = "₹1000" },
        new RateItem { ColourName = "Ruby Red", ProductName = "HD Polymer Mix", PmrNo = "PMR-015", ColourCode = "RD-205", Price = "₹750" },
        new RateItem { ColourName = "Sunset Orange", ProductName = "HD Polymer Mix", PmrNo = "PMR-023", ColourCode = "SO-310", Price = "₹800" },
        new RateItem { ColourName = "Ocean Wave", ProductName = "HD Polymer Mix", PmrNo = "PMR-032", ColourCode = "OW-457", Price = "₹1000" },
        new RateItem { ColourName = "Mountain Gray", ProductName = "HD Polymer Mix", PmrNo = "PMR-041", ColourCode = "MG-512", Price = "₹800" },
        new RateItem { ColourName = "Desert Sand", ProductName = "HD Polymer Mix", PmrNo = "PMR-050", ColourCode = "DS-678", Price = "₹750" },
        new RateItem { ColourName = "Berry Purple", ProductName = "HD Polymer Mix", PmrNo = "PMR-059", ColourCode = "BP-345", Price = "₹820" },
        new RateItem { ColourName = "Twilight Blue", ProductName = "HD Polymer Mix", PmrNo = "PMR-067", ColourCode = "TB-218", Price = "₹800" },
        new RateItem { ColourName = "Pine Green", ProductName = "HD Polymer Mix", PmrNo = "PMR-075", ColourCode = "PG-119", Price = "₹1000" }
    };

    private void ToggleSelectAll()
    {
        foreach (var item in rateItems)
        {
            item.IsSelected = selectAll;
        }
    }

    private void OnItemChanged()
    {
        selectAll = rateItems.All(i => i.IsSelected);
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Submit()
    {
        await OnSubmit.InvokeAsync();
        await Close();
    }

    public class RateItem
    {
        public bool IsSelected { get; set; }
        public string ColourName { get; set; } = "";
        public string ProductName { get; set; } = "";
        public string PmrNo { get; set; } = "";
        public string ColourCode { get; set; } = "";
        public string Price { get; set; } = "";
        public string NewPrice { get; set; } = "";
    }
}
