                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">
                                    <input type="checkbox" class="cr-checkbox" />
                                </td>
                                <td>Sunset Orange</td>
                                <td>HD Polymer Mix</td>
                                <td>PMR-023</td>
                                <td>SO-310</td>
                                <td>₹800</td>
                                <td>
                                    <input type="text" class="cr-input" placeholder="Enter" />
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">
                                    <input type="checkbox" class="cr-checkbox" />
                                </td>
                                <td>Ocean Wave</td>
                                <td>HD Polymer Mix</td>
                                <td>PMR-032</td>
                                <td>OW-457</td>
