@using DeepPolymer.Constants

@if (IsOpen)
{
    <div class="dialog-overlay" @onclick="Close">
        <div class="dialog-card" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3 class="dialog-title">Add IP Address</h3>
                <button class="dialog-close-btn" type="button" @onclick="Close">&times;</button>
            </div>
            <div class="dialog-body">
                <!-- IP Address -->
                <div class="dialog-form-group">
                    <label class="dialog-label">
                        IP Address <span class="required-star">*</span>
                    </label>
                    <input class="dialog-input" type="text" placeholder="IP Address" @bind="IPAddress" />
                </div>
            </div>
            <div class="dialog-footer">
                <button class="dialog-cancel-btn" type="button" @onclick="Close">Cancel</button>
                <button class="dialog-submit-btn" style="background-color: @ColorConstant.PrimaryColor;" type="button" @onclick="Submit">Submit</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    private string IPAddress { get; set; } = "";
    private bool IsActive { get; set; } = true;

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Submit()
    {
        await OnSubmit.InvokeAsync();
        await Close();
    }
}

