@using DeepPolymer.Constants

@if (IsOpen)
{
    <div class="dialog-overlay" @onclick="Close">
        <div class="dialog-card" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3 class="dialog-title">Add Material</h3>
                <button class="dialog-close-btn" type="button" @onclick="Close">&times;</button>
            </div>
            <div class="dialog-body">

                <!-- Colour Name -->
                <div class="dialog-form-group">
                    <label class="dialog-label">Colour Name <span class="required-star">*</span></label>
                    <div class="dialog-select-wrap" style="position: relative;">
                        <select class="dialog-input dialog-select" @bind="ColourName" style="appearance: none; -webkit-appearance: none; padding-right: 30px; width: 100%;">
                            <option value="" disabled selected>Colour Name</option>
                            <option value="Ocean Blue - A">Ocean Blue - A</option>
                            <option value="Ocean Blue - B">Ocean Blue - B</option>
                        </select>
                        <span class="dialog-select-chevron" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #888888;">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </div>
                </div>

                <!-- Material Name -->
                <div class="dialog-form-group">
                    <label class="dialog-label">Material Name <span class="required-star">*</span></label>
                    <input class="dialog-input" type="text" placeholder="Material Name" @bind="MaterialName" />
                </div>

                <!-- Rate -->
                <div class="dialog-form-group">
                    <label class="dialog-label">Rate(₹) <span class="required-star">*</span></label>
                    <input class="dialog-input" type="text" placeholder="Rate(₹)" @bind="Rate" />
                </div>

            </div>
            <div class="dialog-footer">
                <button class="dialog-cancel-btn" type="button" @onclick="Close">Cancel</button>
                <button class="dialog-submit-btn"
                        style="background-color: @ColorConstant.PrimaryColor;"
                        type="button"
                        @onclick="Submit">Submit</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    private string ColourName { get; set; } = "";
    private string MaterialName { get; set; } = "";
    private string Rate { get; set; } = "";

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Submit()
    {
        await OnSubmit.InvokeAsync();
        await Close();
    }
}
