@page "/ip-addresses"
@rendermode InteractiveServer



<div class="ip-page">
    <!-- Page Header -->
    <div class="ip-page-header">
        <div>
            <h1 class="ip-page-title">Manage IP Addresses</h1>
            <p class="ip-page-subtitle">Control and manage secure device access for authorized users.</p>
        </div>
        <button class="ip-add-btn" id="btn-add-ip" @onclick="() => showAddDialog = true">Add IP Address</button>
    </div>

    <AddIPAddressDialog @bind-IsOpen="showAddDialog" />

    <!-- Table Card -->
    <div class="ip-card">
        <!-- Search Filter -->
        <div class="ip-filter-row">
            <div class="ip-search-wrapper">
                <select class="ip-search-select" id="search-ip">
                    <option selected disabled>Search IP Address</option>
                    <option>192.168.1.101</option>
                    <option>192.168.1.103</option>
                </select>
                <span class="ip-search-chevron">&#8964;</span>
            </div>
        </div>

        <!-- Data Table -->
        <table class="ip-table">
            <thead>
                <tr>
                    <th>IP Address</th>
                    <th style="text-align:center;">Status</th>
                    <th>Created Date</th>
                    <th style="text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>192.168.1.101</td>
                    <td style="text-align:center;"><span class="ip-status-badge active">Active</span></td>
                    <td>11-05-2026</td>
                    <td style="text-align:center;">
                        <div class="ip-action-cell">
                            <label class="ip-toggle">
                                <input type="checkbox" checked id="toggle-ip-1" />
                                <span class="ip-toggle-slider"></span>
                            </label>
                            <button class="ip-icon-btn edit" title="Edit" id="edit-ip-1">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="ip-icon-btn delete" title="Delete" id="delete-ip-1">
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>192.168.1.103</td>
                    <td style="text-align:center;"><span class="ip-status-badge active">Active</span></td>
