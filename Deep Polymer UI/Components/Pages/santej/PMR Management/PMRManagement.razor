                    <option selected disabled>Product Name</option>
                </select>
                <span class="filter-chevron">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
            </div>

            <div class="filter-item">
                <select class="filter-select">
                    <option selected disabled>Colour Name</option>
                </select>
                <span class="filter-chevron">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
            </div>

            <div class="filter-item">
                <select class="filter-select">
                    <option selected disabled>Sample Type</option>
                </select>
                <span class="filter-chevron">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
            </div>

            <div class="filter-item">
                <select class="filter-select">
                    <option selected disabled>Request Status</option>
                </select>
                <span class="filter-chevron">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
