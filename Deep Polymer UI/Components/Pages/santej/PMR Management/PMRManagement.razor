@code {
    private bool showDetailPage = false;
    private string selectedPmrNo = "PMR-001";

    private void OpenDetailPage(string pmrNo = "PMR-001")
    {
        selectedPmrNo = pmrNo;
        showDetailPage = true;
    }

    private void BackToTable()
    {
        showDetailPage = false;
    }
}
