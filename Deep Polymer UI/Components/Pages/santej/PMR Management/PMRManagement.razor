@page "/santej/pmr-management"
@page "/"
@rendermode InteractiveServer

<PageTitle>PMR Management</PageTitle>

@if (showDetailPage)
{
    <SantejPmrDetailView PmrNo="@selectedPmrNo" OnBack="BackToTable" />
}
