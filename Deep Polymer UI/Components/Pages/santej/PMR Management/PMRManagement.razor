<EmailToMarketingUserDialog @bind-IsOpen="showEmailMarketingDialog" />
<SantejCreatePmrDialog @bind-IsOpen="showCreatePmrDialog" />
<SantejPmrDetailsDialog @bind-IsOpen="showPmrDetailsDialog" PmrNo="@selectedPmrNo" />

@code {
    private string selectedPmrNo = "PMR-001";
    private bool showEmailMarketingDialog = false;
    private bool showCreatePmrDialog = false;
    private bool showPmrDetailsDialog = false;

    protected override void OnInitialized()
    {
        if (ColorConstant.IsLabUser)
        {
            Navigation.NavigateTo("/santej/lab-user/pmr-management");
        }
    }

    private void OpenPmrDetailsDialog(string pmrNo = "PMR-001")
    {
        if (ColorConstant.IsAdmin)
        {
            Navigation.NavigateTo($"/santej/pmr-detail-view/{pmrNo}");
        }
        else
        {
            selectedPmrNo = pmrNo;
            showPmrDetailsDialog = true;
        }
    }

    private void OpenDetailPage(string pmrNo = "PMR-001")
    {
        Navigation.NavigateTo($"/santej/pmr-detail-view/{pmrNo}");
    }
}







