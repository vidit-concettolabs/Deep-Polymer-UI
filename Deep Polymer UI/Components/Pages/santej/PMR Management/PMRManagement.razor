@page "/santej/pmr-management"
@page "/"

<PageTitle>PMR Management</PageTitle>

<div class="pmr-container">
    <!-- PMR Page Header -->
    <div class="pmr-header">
        <h1 class="pmr-title">PMR Management</h1>
        <p class="pmr-desc">Manage, review, and process all PMR requests from a centralized admin panel.</p>
    </div>

    <!-- Filter Section -->
    <div class="pmr-filter-row">
        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>PMR</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Customer Name</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Product Name</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Colour Name</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Colour Code</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Status</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>
    </div>

