@page "/santej/pmr-management"
@rendermode InteractiveServer

@using DeepPolymer.Constants
@using Deep_Polymer_UI.Components.Pages.santej.AlertDialogs
@inject NavigationManager Navigation




<PageTitle>PMR Management</PageTitle>

<div class="pmr-container">

        <!-- PMR Page Header -->
        <div class="pmr-header flex-header">
            <div>
                <h1 class="pmr-title">PMR Management</h1>
                <p class="pmr-desc">Create, manage, and track product matching requests efficiently.</p>
            </div>
            
            @if (ColorConstant.BranchFlag == 1 && ColorConstant.IsPmrGenerator)
            {
                <div class="pmr-header-actions">
                    <button type="button" class="pmr-btn-email" @onclick="() => showEmailMarketingDialog = true">Email to Marketing User</button>
                    <button type="button" class="pmr-btn-create" @onclick="() => showCreatePmrDialog = true">Create PMR</button>
                </div>
            }


        </div>

