                    <th>Customer Name</th>
                    <th>Product Name</th>
                    <th>Colour Name</th>
                    <th>Colour Code</th>
                    <th>Total Cost</th>
                    <th>Submitted Date</th>
                    <th style="text-align: center;">Request Status</th>
                    <th style="text-align: center;">Action</th>
                </tr>
            </thead>
