@if (IsOpen)
{
    <div class="spdd-overlay" @onclick="Close">
        <div class="spdd-modal" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="spdd-header">
                <div class="spdd-title-group">
                    <h3 class="spdd-title">PMR Details - #@(string.IsNullOrEmpty(PmrNo) ? "1" : PmrNo)</h3>
                    <span class="spdd-badge-purple">Approved by User</span>
                </div>
                <button type="button" class="spdd-close-btn" @onclick="Close">&times;</button>
            </div>

            <!-- Body Grid (3 Columns) -->
            <div class="spdd-body">
                <div class="spdd-grid">
                    <!-- Row 1 -->
                    <div class="spdd-item">
                        <span class="spdd-label">PMR Number</span>
                        <span class="spdd-value">PMR-001</span>
                    </div>
                    <div class="spdd-item">
                        <span class="spdd-label">Received From</span>
                        <span class="spdd-value">Vivek Patel</span>
                    </div>
                    <div class="spdd-item">
                        <span class="spdd-label">Region</span>
                        <span class="spdd-value">Gujarat</span>
                    </div>

                    <!-- Row 2 -->
                    <div class="spdd-item">
                        <span class="spdd-label">Sample Request Date</span>
                        <span class="spdd-value">15-05-2026</span>
                    </div>
                    <div class="spdd-item">
                        <span class="spdd-label">Product Name</span>
                        <span class="spdd-value">HD Polymer Mix</span>
                    </div>
                    <div class="spdd-item">
                        <span class="spdd-label">Customer Name</span>
                        <span class="spdd-value">Ramesh Patel</span>
                    </div>

                    <!-- Row 3 -->
                    <div class="spdd-item">
                        <span class="spdd-label">City</span>
                        <span class="spdd-value">Ahmedabad</span>
                    </div>
                    <div class="spdd-item">
                        <span class="spdd-label">Colour Name</span>
                        <span class="spdd-value">Ocean Blue - A</span>
                    </div>
                    <div class="spdd-item">
                        <span class="spdd-label">Submitted Date</span>
                        <span class="spdd-value">19-05-2026</span>
                    </div>

                    <!-- Row 4 -->
                    <div class="spdd-item">
                        <span class="spdd-label">Target Price</span>
                        <span class="spdd-value">&#8377;185/kg</span>
                    </div>
                    <div class="spdd-item">
                        <span class="spdd-label">Monthly Quantity</span>
                        <span class="spdd-value">12,500 KG</span>
                    </div>
                    <div class="spdd-item">
                        <span class="spdd-label">Application</span>
                        <span class="spdd-value">Automotive Plastic Components</span>
                    </div>

                    <!-- Row 5 -->
                    <div class="spdd-item">
                        <span class="spdd-label">Process Formulation</span>
                        <span class="spdd-value">Injection Molding Compound</span>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="spdd-footer">
                <button type="button" class="spdd-btn-close" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string PmrNo { get; set; } = "1";

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
