@page "/santej/lab-user/pmr-management"
@rendermode InteractiveServer

@using DeepPolymer.Constants
@using Deep_Polymer_UI.Components.Pages.santej.AlertDialogs
@inject NavigationManager Navigation

<PageTitle>PMR Request List - Lab User</PageTitle>

<div class="lab-pmr-container">

    <!-- Page Header -->
    <div class="lab-pmr-header">
        <div>
            <h1 class="lab-pmr-title">PMR Request List</h1>
            <p class="lab-pmr-desc">View and process submitted product matching requests efficiently.</p>
        </div>
        <div class="lab-header-badges">
            <span class="lab-stat-badge-revised">Revised by Admin <strong>01</strong></span>
            <span class="lab-stat-badge-total">Total PMRs <strong>16</strong></span>
        </div>
    </div>

    <!-- Filter Section (Static Controls) -->
    <div class="lab-pmr-filter-row">
        <div class="lab-filter-item">
            <select class="lab-filter-select">
                <option selected disabled>Search PMR</option>
            </select>
            <span class="lab-filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="lab-filter-item">
            <select class="lab-filter-select">
                <option selected disabled>Search Customer Name</option>
            </select>
            <span class="lab-filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="lab-filter-item">
            <select class="lab-filter-select">
                <option selected disabled>Search Product Name</option>
            </select>
            <span class="lab-filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="lab-filter-item">
            <select class="lab-filter-select">
                <option selected disabled>Search Colour Name</option>
            </select>
            <span class="lab-filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <div class="lab-filter-item">
            <select class="lab-filter-select">
                <option selected disabled>Status</option>
            </select>
            <span class="lab-filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>
    </div>

    <!-- PMR Table Section (Static HTML Rows) -->
    <div class="lab-pmr-table-wrapper">
        <table class="lab-pmr-table">
            <thead>
                <tr>
                    <th>PMR No.</th>
                    <th>Customer Name</th>
                    <th>Product Name</th>
                    <th>Colour Name</th>
                    <th>Submitted Date</th>
                    <th class="center-col">Request Status</th>
                    <th class="center-col">Action</th>
                </tr>
            </thead>
            <tbody>
                <!-- Row 1 -->
                <tr>
                    <td>PMR-001</td>
                    <td>Ramesh Patel</td>
