<SantejPmrDetailsDialog @bind-IsOpen="showDetailsDialog" PmrNo="@selectedPmrNumber" />

@code {
    private bool showDetailsDialog = false;
    private string selectedPmrNumber = "";

    private void OpenDetailsDialog(string pmrNo)
    {
        Navigation.NavigateTo($"/santej/lab-user/pmr-detail/{pmrNo}");
    }

    private void OpenDetailPage(string pmrNo)
    {
        Navigation.NavigateTo($"/santej/lab-user/pmr-detail/{pmrNo}");
    }
}
