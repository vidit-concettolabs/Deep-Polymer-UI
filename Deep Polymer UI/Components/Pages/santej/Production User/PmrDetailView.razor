@page "/santej/production-user/pmr-detail/{PmrNo}"
@page "/santej/production-user/pmr-detail"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Sections
@inject NavigationManager Navigation

<!-- Inject Back button into main layout header slot -->
<SectionContent SectionName="header-back-slot">
    <a class="header-back-btn" href="santej/production-user/pmr-management">
        <svg viewBox="0 0 24 24">
            <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
    </a>
</SectionContent>

<PageTitle>Production PMR Details - Santej</PageTitle>

<div class="prod-detail-page">
    <!-- Header Block -->
    <div class="prod-detail-header-block">
        <div class="prod-detail-header-title-row">
            <h1 class="prod-detail-header-title">Production Workflow Details</h1>
            <span class="status-badge status-in-production">In Production</span>
        </div>
        <p class="prod-detail-header-subtitle">Review approved PMR details, raw material specifications, and update production progress.</p>
    </div>

    <!-- 2-Column Main Grid -->
    <div class="prod-detail-main-grid">
        <!-- LEFT COLUMN: PMR Information Card -->
        <div class="prod-left-info-card">
            <div class="prod-info-list">
                <div class="prod-info-item">
                    <span class="prod-info-label">PMR Number</span>
                    <span class="prod-info-value">@(string.IsNullOrEmpty(PmrNo) ? "PMR-1001" : PmrNo)</span>
                </div>
                <div class="prod-info-item">
                    <span class="prod-info-label">Customer Name</span>
                    <span class="prod-info-value">Ramesh Patel</span>
                </div>
                <div class="prod-info-item">
                    <span class="prod-info-label">Product Name</span>
                    <span class="prod-info-value">HD Polymer Mix</span>
                </div>
                <div class="prod-info-item">
                    <span class="prod-info-label">Colour Details</span>
                    <span class="prod-info-value">Ocean Blue (BL-101)</span>
                </div>
                <div class="prod-info-item">
                    <span class="prod-info-label">Monthly Quantity</span>
                    <span class="prod-info-value">12,500 KG</span>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Production Content Card -->
        <div class="prod-right-content-card">
            <!-- Card Top Row -->
            <div class="prod-card-top-row">
                <div>
                    <h2 class="prod-card-title">Production Raw Material Specifications</h2>
                    <p class="prod-detail-header-subtitle">Approved raw material weights for production line execution.</p>
                </div>
            </div>

            <!-- Table Container -->
            <div class="prod-table-container">
                <table class="prod-weights-table">
                    <thead>
                        <tr>
                            <th style="width: 50%;">Raw Material</th>
                            <th style="width: 25%; text-align: center;">Formula Weight(kgs)</th>
                            <th style="width: 25%; text-align: center;">Allocated Batch(kgs)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Titanium Dioxide</td>
                            <td style="text-align: center;">1.25</td>
                            <td style="text-align: center;">1.25</td>
                        </tr>
                        <tr>
                            <td>Titanium Dioxide</td>
                            <td style="text-align: center;">3.50</td>
                            <td style="text-align: center;">3.50</td>
                        </tr>
                        <tr>
                            <td>Titanium Dioxide</td>
                            <td style="text-align: center;">2.25</td>
                            <td style="text-align: center;">2.25</td>
                        </tr>
                        <tr>
                            <td>Titanium Dioxide</td>
                            <td style="text-align: center;">0.55</td>
                            <td style="text-align: center;">0.55</td>
                        </tr>
                        <tr>
                            <td>Titanium Dioxide</td>
                            <td style="text-align: center;">0.95</td>
                            <td style="text-align: center;">0.95</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Bottom Action Row -->
            <div class="prod-card-bottom-row">
                <button type="button" class="prod-btn-cancel-action" @onclick="GoBack">Back to List</button>
                <button type="button" class="prod-btn-submit-action" @onclick="GoBack">Complete Production</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? PmrNo { get; set; }

    private void GoBack()
    {
        Navigation.NavigateTo("/santej/production-user/pmr-management");
    }
}
