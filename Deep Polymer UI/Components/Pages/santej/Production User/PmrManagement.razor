            <select class="prod-filter-select">
                <option value="" disabled selected>Product Name</option>
                <option value="HD Polymer Mix">HD Polymer Mix</option>
                <option value="Flexi Compound">Flexi Compound</option>
            </select>
            <span class="prod-select-chevron">
                <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
        </div>

        <!-- 4. Colour Name -->
        <div class="prod-select-wrapper">
            <select class="prod-filter-select">
                <option value="" disabled selected>Colour Name</option>
                <option value="Ocean Blue">Ocean Blue</option>
                <option value="Jet Black">Jet Black</option>
            </select>
            <span class="prod-select-chevron">
                <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
        </div>

        <!-- 5. Colour Code -->
