<!-- Modal Dialogs -->
<SantejProductionPmrDetailsDialog @bind-IsOpen="showPmrDetailsDialog" PmrNo="@selectedPmrNo" />
<ProductionRecommendedDialog @bind-IsOpen="showRecommendedDialog" PmrNo="@selectedPmrNo" />

@code {
    private bool showPmrDetailsDialog = false;
    private bool showRecommendedDialog = false;
    private string selectedPmrNo = "1";

    private void ViewPmrDetails(string pmrNo)
    {
        selectedPmrNo = pmrNo;
        showPmrDetailsDialog = true;
    }

    private void OpenRecommendedDialog(string pmrNo)
    {
        selectedPmrNo = pmrNo;
        showRecommendedDialog = true;
    }
}
