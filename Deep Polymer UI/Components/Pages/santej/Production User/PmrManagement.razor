                <option value="" disabled selected>PMR No.</option>
                <option value="PMR-1001">PMR-1001</option>
                <option value="PMR-1002">PMR-1002</option>
                <option value="PMR-1003">PMR-1003</option>
            </select>
            <span class="prod-select-chevron">
                <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
        </div>

        <!-- 2. Customer Name -->
        <div class="prod-select-wrapper">
            <select class="prod-filter-select">
                <option value="" disabled selected>Customer Name</option>
                <option value="Ramesh Patel">Ramesh Patel</option>
                <option value="Karan Desai">Karan Desai</option>
            </select>
            <span class="prod-select-chevron">
                <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
