@page "/masters/color"

<div class="masters-container">
    <!-- Top Tabs Row -->
    <MastersTabs ActiveTab="color" />

    <!-- Filter/Search Section -->
    <div class="masters-filter-row">
        <div class="filter-spacer"></div>
        
        <!-- Search Color Name Dropdown -->
        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Search Color Name</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <!-- Search Color Code Dropdown -->
        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Search Color Code</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <!-- Add Color Button -->
        <button class="add-customer-btn" type="button">Add Color</button>
    </div>

    <!-- Color Table Wrapper -->
    <div class="masters-table-wrapper">
        <table class="masters-table">
            <thead>
                <tr>
                    <th>Colour Name</th>
                    <th>Colour Code</th>
                    <th>Updated Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var col in Colors)
                {
                    <tr>
                        <td>@col.Name</td>
                        <td>@col.Code</td>
                        <td>@col.UpdatedDate</td>
                        <td>
                            <div class="actions-container">
                                <button class="action-edit-btn" type="button" title="Edit Color">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 20h9" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <button class="action-delete-btn" type="button" title="Delete Color">
                                    <svg viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="10" y1="11" x2="10" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="14" y1="11" x2="14" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Table Footer / Pagination Row -->
        <div class="masters-pagination-row">
            <span class="pagination-info">Showing 1-10 of 12 list</span>
            <div class="pagination-nav">
                <button class="pagination-btn disabled" type="button" title="Previous Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button class="pagination-btn active" type="button">1</button>
                <button class="pagination-btn" type="button">2</button>
                <button class="pagination-btn" type="button" title="Next Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private class ColorModel
    {
        public string Name { get; set; }
        public string Code { get; set; }
        public string UpdatedDate { get; set; }
    }

    private List<ColorModel> Colors = new()
    {
        new() { Name = "Utility White", Code = "White-101", UpdatedDate = "11-05-2026" },
        new() { Name = "Super White", Code = "White-105", UpdatedDate = "26-04-2026" },
        new() { Name = "Pure White", Code = "White-112", UpdatedDate = "15-04-2026" },
        new() { Name = "Bright White", Code = "White-120", UpdatedDate = "02-03-2026" },
        new() { Name = "Snowy White", Code = "White-125", UpdatedDate = "18-02-2026" },
        new() { Name = "Crystal White", Code = "White-130", UpdatedDate = "07-01-2026" },
        new() { Name = "Gleaming White", Code = "White-135", UpdatedDate = "25-12-2025" },
        new() { Name = "Pearl White", Code = "White-140", UpdatedDate = "10-11-2025" },
        new() { Name = "Luminous White", Code = "White-145", UpdatedDate = "30-09-2025" },
        new() { Name = "Alpine White", Code = "White-150", UpdatedDate = "15-08-2025" }
    };
}
