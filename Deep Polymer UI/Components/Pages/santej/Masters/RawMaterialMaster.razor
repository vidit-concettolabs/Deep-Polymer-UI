    {
        public string Name { get; set; }
        public string Rate { get; set; }
        public string UpdatedDate { get; set; }
    }

    private List<MaterialModel> Materials = new()
    {
        new() { Name = "ANTIOXIDENT-B215", Rate = "280.00", UpdatedDate = "11-05-2026" },
        new() { Name = "ANTIOXIDENT-B 225", Rate = "285.00", UpdatedDate = "26-04-2026" },
        new() { Name = "ANTIOXIDENT-KINOX30", Rate = "669.18", UpdatedDate = "15-04-2026" },
        new() { Name = "ANTI OXIDENT-RADINT GRUNELES", Rate = "211.00", UpdatedDate = "02-03-2026" },
