        new() { Name = "ANTIOXIDENT-OMEGA-9", Rate = "450.75", UpdatedDate = "09-07-2026" },
        new() { Name = "ANTIOXIDENT-ZENITH", Rate = "520.00", UpdatedDate = "18-08-2026" },
        new() { Name = "ANTIOXIDENT-NEUTRA-B", Rate = "395.80", UpdatedDate = "05-09-2026" },
        new() { Name = "ANTIOXIDENT-PREMIER-5", Rate = "675.00", UpdatedDate = "12-10-2026" },
