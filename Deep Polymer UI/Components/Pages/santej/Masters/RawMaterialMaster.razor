@page "/masters/raw-material"
@using DeepPolymer.Constants
@rendermode InteractiveServer

<div class="masters-container">
    @if (ColorConstant.BranchFlag == 2 || ColorConstant.IsProductionHead)
    {
        <!-- Hajipur / Production Head Header Design (Transparent Background, No White Card) -->
        <div class="rmm-top-header">
            <div class="rmm-title-area">
                <h2 class="rmm-title">Raw Material Master</h2>
                <p class="rmm-subtitle">Manage raw material data and pricing for all existing and new PMRs.</p>
            </div>
            <div class="rmm-header-actions">
                <button class="rmm-import-btn" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="rmm-import-icon">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-linecap="round" stroke-linejoin="round"/>
                        <polyline points="7 10 12 15 17 10" stroke-linecap="round" stroke-linejoin="round"/>
                        <line x1="12" y1="15" x2="12" y2="3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Import
                </button>
                <button class="add-customer-btn rmm-add-btn" type="button" @onclick="() => showAddDialog = true">Add Material</button>
            </div>
        </div>

        <!-- Search Bar Row (Separate White Card Section) -->
        <div class="rmm-search-row">
            <div class="filter-item rmm-search-select-wrap">
                <select class="filter-select">
                    <option selected disabled>Search Material</option>
                </select>
                <span class="filter-chevron">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
            </div>
        </div>

