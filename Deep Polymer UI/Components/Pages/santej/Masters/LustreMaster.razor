@page "/masters/lustre"

<div class="masters-container">
    <MastersTabs ActiveTab="lustre" />

    <!-- Filter/Search Section -->
    <div class="masters-filter-row">
        <div class="filter-spacer"></div>
        
        <!-- Search Lustre Master Name Dropdown -->
        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Search Lustre Master Name</option>
                @foreach (var lu in Lustres)
                {
                    <option value="@lu.Name">@lu.Name</option>
                }
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <!-- Add Lustre Master Button -->
        <button class="add-customer-btn" type="button">Add Lustre Master</button>
    </div>

    <!-- Lustre Table Wrapper -->
    <div class="masters-table-wrapper lustre-table">
        <table class="masters-table">
            <thead>
                <tr>
                    <th class="text-start" style="width: 30%;">Lustre Name</th>
                    <th class="text-start" style="width: 50%;">Description</th>
                    <th class="text-center" style="width: 10%;">Status</th>
                    <th class="text-center" style="width: 10%;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lu in Lustres.Take(10))
                {
                    <tr>
                        <td class="text-start">@lu.Name</td>
                        <td class="text-start">@lu.Description</td>
                        <td class="text-center">
                            <label class="status-switch">
                                <input type="checkbox" checked="@lu.IsActive" @onchange="(e) => ToggleStatus(lu, e)" />
                                <span class="status-slider"></span>
                            </label>
                        </td>
                        <td class="text-center">
                            <div class="actions-container">
                                <button class="action-edit-btn" type="button" title="Edit Lustre">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 20h9" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <button class="action-delete-btn" type="button" title="Delete Lustre">
                                    <svg viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="10" y1="11" x2="10" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="14" y1="11" x2="14" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Table Footer / Pagination Row -->
        <div class="masters-pagination-row">
            <span class="pagination-info">Showing 1-10 of 12 list</span>
            <div class="pagination-nav">
                <button class="pagination-btn disabled" type="button" title="Previous Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button class="pagination-btn active" type="button">1</button>
                <button class="pagination-btn" type="button">2</button>
                <button class="pagination-btn" type="button" title="Next Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private class LustreModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }

    private List<LustreModel> Lustres = new()
    {
        new() { Name = "Lustre Name", Description = "Description", IsActive = true },
        new() { Name = "Matte", Description = "A non-reflective, flat finish that diffuses light softly", IsActive = true },
        new() { Name = "Glossy", Description = "A shiny, reflective surface that enhances color vibrancy", IsActive = true },
        new() { Name = "Satin", Description = "A smooth finish with soft sheen, between matte and glossy", IsActive = true },
        new() { Name = "Pearlescent", Description = "Iridescent finish that mimics the look of pearls, with subtle color shifts", IsActive = true },
        new() { Name = "Metallic", Description = "A lustrous finish that simulates the appearance of metal", IsActive = true },
        new() { Name = "Silky", Description = "A smooth, soft finish with gentle sheen, resembling silk fabric", IsActive = true },
        new() { Name = "Velvet", Description = "A rich, soft finish with a slightly plush texture and muted sheen", IsActive = true },
        new() { Name = "Crackle", Description = "A textured finish with intentional cracks that create an antique effect", IsActive = true },
        new() { Name = "Chalky", Description = "A matte finish with a powdery texture that resembles chalk", IsActive = true },
        new() { Name = "Luminous", Description = "A bright, glowing finish that emits soft light visibility.", IsActive = true },
        new() { Name = "Shimmer", Description = "A sparkling finish containing small reflective particles.", IsActive = true }
    };

    private void ToggleStatus(LustreModel item, ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            item.IsActive = val;
        }
    }
}
