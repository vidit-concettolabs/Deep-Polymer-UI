@page "/masters/twist"
@rendermode InteractiveServer

<div class="masters-container">
    <MastersTabs ActiveTab="twist" />

    <!-- Filter/Search Section -->
    <div class="masters-filter-row">
        <div class="filter-spacer"></div>
        
        <!-- Search Twist Master Name Dropdown -->
        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Search Twist Master Name</option>
                @foreach (var tw in Twists)
                {
                    <option value="@tw.Name">@tw.Name</option>
                }
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <!-- Add Twist Master Button -->
        <button class="add-customer-btn" type="button" @onclick="() => showAddDialog = true">Add Twist Master</button>
    </div>

    <AddTwistMasterDialog @bind-IsOpen="showAddDialog" />

    <!-- Twist Table Wrapper -->
    <div class="masters-table-wrapper twist-table">
        <table class="masters-table">
            <thead>
                <tr>
                    <th class="text-start" style="width: 30%;">Twist Master Name</th>
                    <th class="text-start" style="width: 50%;">Description</th>
                    <th class="text-center" style="width: 10%;">Status</th>
                    <th class="text-center" style="width: 10%;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tw in Twists.Take(10))
                {
                    <tr>
                        <td class="text-start">@tw.Name</td>
                        <td class="text-start">@tw.Description</td>
                        <td class="text-center">
                            <label class="status-switch">
                                <input type="checkbox" checked="@tw.IsActive" @onchange="(e) => ToggleStatus(tw, e)" />
                                <span class="status-slider"></span>
                            </label>
                        </td>
                        <td class="text-center">
                            <div class="actions-container">
                                <button class="action-edit-btn" type="button" title="Edit Twist">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 20h9" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <button class="action-delete-btn" type="button" title="Delete Twist">
                                    <svg viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="10" y1="11" x2="10" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="14" y1="11" x2="14" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Table Footer / Pagination Row -->
        <div class="masters-pagination-row">
            <span class="pagination-info">Showing 1-10 of 12 list</span>
            <div class="pagination-nav">
                <button class="pagination-btn disabled" type="button" title="Previous Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button class="pagination-btn active" type="button">1</button>
                <button class="pagination-btn" type="button">2</button>
                <button class="pagination-btn" type="button" title="Next Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool showAddDialog = false;

    private class TwistModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }

    private List<TwistModel> Twists = new()
    {
        new() { Name = "Twist Master Name", Description = "Description", IsActive = true },
        new() { Name = "Spiral Sage", Description = "Expert in intricate twist patterns and advanced weaving techniques.", IsActive = true },
        new() { Name = "Helix Architect", Description = "Designs complex twisted structures for architectural and artistic projects.", IsActive = true },
        new() { Name = "Torque Tactician", Description = "Specializes in the dynamics and application of twisting forces in machinery.", IsActive = true },
        new() { Name = "Vortex Virtuoso", Description = "Master of creating swirling twist effects in digital and physical media.", IsActive = true },
        new() { Name = "Corkscrew Commander", Description = "Leader in developing innovative twist-based mechanisms and gadgets.", IsActive = true },
        new() { Name = "Whorl Whisperer", Description = "Knows the secrets of natural spiral formations and their practical uses.", IsActive = true },
        new() { Name = "Torsion Trailblazer", Description = "Pioneer in the study and manipulation of torsional stress in materials.", IsActive = true },
        new() { Name = "Ribbon Wrangler", Description = "Expert in ribbon twists and aesthetic spiral designs for textiles.", IsActive = true },
        new() { Name = "Spindle Specialist", Description = "Focused on the precision control of spindle twists in manufacturing.", IsActive = true },
        new() { Name = "Coil Creator", Description = "Specialist in producing high-resilience spring coils.", IsActive = true },
        new() { Name = "Braid Builder", Description = "Focuses on interlocking twists for high-strength ropes.", IsActive = true }
    };

    private void ToggleStatus(TwistModel item, ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            item.IsActive = val;
        }
    }
}
