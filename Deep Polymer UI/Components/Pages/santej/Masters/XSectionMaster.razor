@page "/masters/x-section"

<div class="masters-container">
    <MastersTabs ActiveTab="x-section" />

    <div class="masters-filter-row">
        <div class="filter-spacer"></div>
        <button class="add-customer-btn" type="button">Add X Section</button>
    </div>

    <div class="masters-table-wrapper" style="padding: 60px 20px; text-align: center; color: #718096;">
        <svg viewBox="0 0 24 24" style="width: 48px; height: 48px; stroke: currentColor; fill: none; stroke-width: 1.5; margin-bottom: 12px; opacity: 0.7;">
            <rect x="3" y="3" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 9l6 6m0-6l-6 6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h4 style="font-weight: 600; margin-bottom: 6px;">X Section Master</h4>
        <p style="font-size: 13px; max-width: 400px; margin: 0 auto;">This master configuration screen is currently under construction for Hajipur Branch.</p>
    </div>
</div>
