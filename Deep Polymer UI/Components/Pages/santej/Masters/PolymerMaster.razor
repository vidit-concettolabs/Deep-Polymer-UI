@page "/masters/polymer"
@rendermode InteractiveServer

<div class="masters-container">
    <MastersTabs ActiveTab="polymer" />

    <!-- Filter/Search Section -->
    <div class="masters-filter-row">
        <div class="filter-spacer"></div>
        
        <!-- Search Polymer Name Dropdown -->
        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Search Polymer Name</option>
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <!-- Add Polymer Button -->
        <button class="add-customer-btn" type="button" @onclick="() => showAddDialog = true">Add Polymer</button>
    </div>

    <AddPolymerDialog @bind-IsOpen="showAddDialog" />

    <!-- Polymer Table Wrapper -->
    <div class="masters-table-wrapper polymer-table">
        <table class="masters-table">
            <thead>
                <tr>
                    <th class="text-start" style="width: 30%;">Polymer Name</th>
                    <th class="text-start" style="width: 50%;">Description</th>
                    <th class="text-center" style="width: 10%;">Status</th>
                    <th class="text-center" style="width: 10%;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var poly in Polymers)
                {
                    <tr>
                        <td class="text-start">@poly.Name</td>
                        <td class="text-start">@poly.Description</td>
                        <td class="text-center">
                            <label class="status-switch">
                                <input type="checkbox" checked="@poly.IsActive" @onchange="(e) => ToggleStatus(poly, e)" />
                                <span class="status-slider"></span>
                            </label>
                        </td>
                        <td class="text-center">
                            <div class="actions-container">
                                <button class="action-edit-btn" type="button" title="Edit Polymer">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 20h9" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <button class="action-delete-btn" type="button" title="Delete Polymer">
                                    <svg viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="10" y1="11" x2="10" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="14" y1="11" x2="14" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Table Footer / Pagination Row -->
        <div class="masters-pagination-row">
            <span class="pagination-info">Showing 1-10 of 12 list</span>
            <div class="pagination-nav">
                <button class="pagination-btn disabled" type="button" title="Previous Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button class="pagination-btn active" type="button">1</button>
                <button class="pagination-btn" type="button">2</button>
                <button class="pagination-btn" type="button" title="Next Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool showAddDialog = false;

    private class PolymerModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }

    private List<PolymerModel> Polymers = new()
    {
        new() { Name = "Polyethylene", Description = "A common thermoplastic used in packaging and containers, known", IsActive = true },
        new() { Name = "Polyvinyl Chloride (PVC)", Description = "A versatile polymer used in pipes, cables, and clothing; resistant to", IsActive = true },
        new() { Name = "Polystyrene", Description = "A rigid, transparent polymer used in disposable cutlery, CD cases,", IsActive = true },
        new() { Name = "Polypropylene", Description = "A lightweight, durable polymer used in automotive parts, textiles, a", IsActive = true },
        new() { Name = "Polycarbonate", Description = "A strong, impact-resistant polymer used in eyewear lenses, bulletpro", IsActive = true },
        new() { Name = "Polytetrafluoroethylene (PTFE)", Description = "Known by the brand name Teflon, used for non-stick coatings and e", IsActive = true },
        new() { Name = "Polyamide (Nylon)", Description = "A synthetic fiber used in textiles, automotive components, and m", IsActive = true },
        new() { Name = "Polyethylene Terephthalate (PET)", Description = "A thermoplastic polymer commonly used in beverage bottles and food", IsActive = true },
        new() { Name = "Polymethyl Methacrylate (PMMA)", Description = "Also known as acrylic or Plexiglas, used as a lightweight, shatter-resistan", IsActive = true }
    };

    private void ToggleStatus(PolymerModel polymer, ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            polymer.IsActive = val;
        }
    }
}
