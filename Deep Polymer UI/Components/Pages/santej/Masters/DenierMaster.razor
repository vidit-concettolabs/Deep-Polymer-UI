@page "/masters/denier"

<div class="masters-container">
    <MastersTabs ActiveTab="denier" />

    <!-- Filter/Search Section -->
    <div class="masters-filter-row">
        <div class="filter-spacer"></div>
        
        <!-- Search Denier Master Name Dropdown -->
        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Search Denier Master Name</option>
                @foreach (var de in Deniers)
                {
                    <option value="@de.Name">@de.Name</option>
                }
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <!-- Add Denier Master Button -->
        <button class="add-customer-btn" type="button">Denier Master</button>
    </div>

    <!-- Denier Table Wrapper -->
    <div class="masters-table-wrapper denier-table">
        <table class="masters-table">
            <thead>
                <tr>
                    <th class="text-start" style="width: 30%;">Denier Name</th>
                    <th class="text-start" style="width: 50%;">Description</th>
                    <th class="text-center" style="width: 10%;">Status</th>
                    <th class="text-center" style="width: 10%;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var de in Deniers.Take(10))
                {
                    <tr>
                        <td class="text-start">@de.Name</td>
                        <td class="text-start">@de.Description</td>
                        <td class="text-center">
                            <label class="status-switch">
                                <input type="checkbox" checked="@de.IsActive" @onchange="(e) => ToggleStatus(de, e)" />
                                <span class="status-slider"></span>
                            </label>
                        </td>
                        <td class="text-center">
                            <div class="actions-container">
                                <button class="action-edit-btn" type="button" title="Edit Denier">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 20h9" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <button class="action-delete-btn" type="button" title="Delete Denier">
                                    <svg viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="10" y1="11" x2="10" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="14" y1="11" x2="14" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Table Footer / Pagination Row -->
        <div class="masters-pagination-row">
            <span class="pagination-info">Showing 1-10 of 12 list</span>
            <div class="pagination-nav">
                <button class="pagination-btn disabled" type="button" title="Previous Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button class="pagination-btn active" type="button">1</button>
                <button class="pagination-btn" type="button">2</button>
                <button class="pagination-btn" type="button" title="Next Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private class DenierModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }

    private List<DenierModel> Deniers = new()
    {
        new() { Name = "X Section Name", Description = "Description", IsActive = true },
        new() { Name = "Y Integration", Description = "Connect your app with third-party services to automate workflow", IsActive = true },
        new() { Name = "Z User Analytics", Description = "Track user behavior and engagement metrics to optimize your", IsActive = true },
        new() { Name = "A Accessibility", Description = "Ensure your product is usable by people with diverse abilities through", IsActive = true },
        new() { Name = "B Security", Description = "Implement robust data protection measures to safeguard user information.", IsActive = true },
        new() { Name = "C Performance", Description = "Optimize load times and responsiveness for a seamless user experience.", IsActive = true },
        new() { Name = "D Onboarding", Description = "Guide new users through features with interactive tutorials and tips.", IsActive = true },
        new() { Name = "E Notifications", Description = "Manage alerts and updates to keep users informed without overwhelm", IsActive = true },
        new() { Name = "F Collaboration", Description = "Enable multiple users to work together efficiently within the platform.", IsActive = true },
        new() { Name = "G Customization", Description = "Allow users to tailor settings and preferences to fit their needs.", IsActive = true },
        new() { Name = "H Globalization", Description = "Support multiple languages, currencies, and localized formatting.", IsActive = true },
        new() { Name = "I Optimization", Description = "Continuous tuning of infrastructure to minimize latency.", IsActive = true }
    };

    private void ToggleStatus(DenierModel item, ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            item.IsActive = val;
        }
    }
}
