@page "/masters/cross-section"
@rendermode InteractiveServer

<div class="masters-container">
    <MastersTabs ActiveTab="cross-section" />

    <!-- Filter/Search Section -->
    <div class="masters-filter-row">
        <div class="filter-spacer"></div>
        
        <!-- Search Cross Section Name Dropdown -->
        <div class="filter-item">
            <select class="filter-select">
                <option selected disabled>Search Cross Section Name</option>
                @foreach (var cs in CrossSections)
                {
                    <option value="@cs.Name">@cs.Name</option>
                }
            </select>
            <span class="filter-chevron">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>

        <!-- Add Cross Section Button -->
        <button class="add-customer-btn" type="button" @onclick="() => showAddDialog = true">Add Cross Section</button>
    </div>

    <AddCrossSectionDialog @bind-IsOpen="showAddDialog" />

    <!-- Cross Section Table Wrapper -->
    <div class="masters-table-wrapper cross-section-table">
        <table class="masters-table">
            <thead>
                <tr>
                    <th class="text-start" style="width: 30%;">Cross Section Name</th>
                    <th class="text-start" style="width: 50%;">Description</th>
                    <th class="text-center" style="width: 10%;">Status</th>
                    <th class="text-center" style="width: 10%;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cs in CrossSections.Take(10))
                {
                    <tr>
                        <td class="text-start">@cs.Name</td>
                        <td class="text-start">@cs.Description</td>
                        <td class="text-center">
                            <label class="status-switch">
                                <input type="checkbox" checked="@cs.IsActive" @onchange="(e) => ToggleStatus(cs, e)" />
                                <span class="status-slider"></span>
                            </label>
                        </td>
                        <td class="text-center">
                            <div class="actions-container">
                                <button class="action-edit-btn" type="button" title="Edit Cross Section">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 20h9" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <button class="action-delete-btn" type="button" title="Delete Cross Section">
                                    <svg viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" stroke-linecap="round" stroke-linejoin="round" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="10" y1="11" x2="10" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                        <line x1="14" y1="11" x2="14" y2="17" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Table Footer / Pagination Row -->
        <div class="masters-pagination-row">
            <span class="pagination-info">Showing 1-10 of 12 list</span>
            <div class="pagination-nav">
                <button class="pagination-btn disabled" type="button" title="Previous Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button class="pagination-btn active" type="button">1</button>
                <button class="pagination-btn" type="button">2</button>
                <button class="pagination-btn" type="button" title="Next Page">
                    <svg viewBox="0 0 24 24">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool showAddDialog = false;

    private class CrossSectionModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }

    private List<CrossSectionModel> CrossSections = new()
    {
        new() { Name = "Cross Section Name", Description = "Description", IsActive = true },
        new() { Name = "Foundation Wall", Description = "A vertical wall below grade supporting the building load.", IsActive = true },
        new() { Name = "Roof Truss", Description = "A triangular framework that supports the roof covering.", IsActive = true },
        new() { Name = "Floor Slab", Description = "A flat horizontal concrete element forming the floor surface.", IsActive = true },
        new() { Name = "Retaining Wall", Description = "A structure holding back soil or rock from a building.", IsActive = true },
        new() { Name = "Curtain Wall", Description = "An outer covering of a building that is non-structural.", IsActive = true },
        new() { Name = "Beam and Girder", Description = "Horizontal structural elements supporting loads above openings.", IsActive = true },
        new() { Name = "Column Section", Description = "Vertical load-bearing member transferring loads to foundation.", IsActive = true },
        new() { Name = "Staircase Section", Description = "Cross-sectional view showing steps and supporting structure.", IsActive = true },
        new() { Name = "Wall Partition", Description = "Interior wall dividing spaces without bearing loads.", IsActive = true },
        new() { Name = "Trench Fill", Description = "A concrete foundation method where trenches are filled to near ground level.", IsActive = true },
        new() { Name = "Suspended Ceiling", Description = "A secondary ceiling hung below the main structural ceiling.", IsActive = true }
    };

    private void ToggleStatus(CrossSectionModel item, ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            item.IsActive = val;
        }
    }
}
