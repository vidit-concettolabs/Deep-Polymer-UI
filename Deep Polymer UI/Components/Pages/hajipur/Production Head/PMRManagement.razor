<!-- PMR Details Dialog Modal -->
<HajipurPmrDetailsDialog @bind-IsOpen="showPmrDetailsDialog" PmrNo="@selectedDialogPmrNo" />

@code {
    private bool showPmrDetailsDialog = false;
    private string selectedDialogPmrNo = "1";

    private void OpenDialog(string pmrNo)
    {
        selectedDialogPmrNo = pmrNo.Replace("PMR-", "");
        showPmrDetailsDialog = true;
    }

    private void ViewPmrDetails(string pmrNo)
    {
        Navigation.NavigateTo($"hajipur/production-head/pmr-detail-view/{pmrNo}");
    }
}
