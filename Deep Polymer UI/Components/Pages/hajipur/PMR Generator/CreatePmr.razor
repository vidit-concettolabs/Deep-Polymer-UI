<!-- PMR History Alert Dialog -->
<PmrHistoryAlertDialog @bind-IsOpen="showPmrHistoryDialog" />
<HajipurPmrSubmittedSuccessDialog @bind-IsOpen="showSuccessDialog" OnOk="HandleSuccessOk" />


@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private bool showSuccessDialog = false;

    private void OpenSuccessDialog()
    {
        showSuccessDialog = true;
    }

    private void HandleSuccessOk()
    {
        Navigation.NavigateTo("/hajipur/pmr-management");
    }


    private string customerName = "";
    private string customerCode = "";
    private string city = "";
    private string receivedFrom = "";
    private string region = "";
    private DateTime requestDate = DateTime.Now;
    private string selectedOldPmr = "";
    private bool showPmrHistoryDialog = false;
    private bool isDesignOutputCollapsed = false;

    private void ToggleDesignOutput()
    {
        isDesignOutputCollapsed = !isDesignOutputCollapsed;
    }


    private int designInputCount = 1;
    private HashSet<int> collapsedItems = new();

    private void OpenPmrHistoryDialog()
    {
        showPmrHistoryDialog = true;
    }

    private void AddDesignInput()
    {
        designInputCount++;
    }

    private void RemoveDesignInput()
    {
        if (designInputCount > 1)
        {
            designInputCount--;
        }
    }

    private void ToggleCollapse(int index)
    {
        if (collapsedItems.Contains(index))
        {
            collapsedItems.Remove(index);
        }
        else
        {
            collapsedItems.Add(index);
        }
    }

    private bool IsCollapsed(int index) => collapsedItems.Contains(index);

    private async Task Close()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
        else
        {
            Navigation.NavigateTo("/hajipur/pmr-management");
        }
    }
}



