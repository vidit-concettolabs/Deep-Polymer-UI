@using Microsoft.AspNetCore.Components

@if (IsOpen)
{
    <div class="hph-dialog-overlay" @onclick="Close">
        <div class="hdpfd-card" @onclick:stopPropagation="true">
            <!-- Dialog Header -->
            <div class="hdpfd-header">
                <div class="hdpfd-header-left">
                    <h3 class="hdpfd-title">Download</h3>
                    <button type="button" class="hdpfd-btn-download-all" @onclick="DownloadAll">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-linecap="round" stroke-linejoin="round"/>
                            <polyline points="7 10 12 15 17 10" stroke-linecap="round" stroke-linejoin="round"/>
                            <line x1="12" y1="15" x2="12" y2="3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>Download All</span>
                    </button>
                </div>
                <button type="button" class="hdpfd-close-btn" @onclick="Close">&times;</button>
            </div>

            <!-- Tabs Header -->
            <div class="hdpfd-tabs-row">
                <button type="button" class="hdpfd-tab-btn @(activeTab == "po" ? "active" : "")" @onclick='() => activeTab = "po"'>
                    PO Documents
                </button>
                <button type="button" class="hdpfd-tab-btn @(activeTab == "formulation" ? "active" : "")" @onclick='() => activeTab = "formulation"'>
                    Formulation Document
                </button>
            </div>

            <!-- Dialog Body -->
            <div class="hdpfd-body">
                @if (activeTab == "po")
                {
                    <div class="hdpfd-doc-list">
                        <!-- Doc Item 1 -->
                        <div class="hdpfd-doc-item">
                            <div class="hdpfd-doc-left">
                                <div class="hdpfd-doc-icon-box">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-linecap="round" stroke-linejoin="round"/>
                                        <polyline points="14 2 14 8 20 8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="13" x2="8" y2="13" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="17" x2="8" y2="17" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <div class="hdpfd-doc-info">
                                    <div class="hdpfd-doc-name">Workplace Safety Policy v2.1</div>
                                    <div class="hdpfd-doc-size">20.2 MB</div>
                                </div>
                            </div>
                            <button type="button" class="hdpfd-doc-download-btn" title="Download Document">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-linecap="round" stroke-linejoin="round"/>
                                    <polyline points="7 10 12 15 17 10" stroke-linecap="round" stroke-linejoin="round"/>
                                    <line x1="12" y1="15" x2="12" y2="3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>

                        <!-- Doc Item 2 -->
                        <div class="hdpfd-doc-item">
                            <div class="hdpfd-doc-left">
                                <div class="hdpfd-doc-icon-box">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-linecap="round" stroke-linejoin="round"/>
                                        <polyline points="14 2 14 8 20 8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="13" x2="8" y2="13" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="17" x2="8" y2="17" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <div class="hdpfd-doc-info">
                                    <div class="hdpfd-doc-name">Emergency Response Plan 2025</div>
                                    <div class="hdpfd-doc-size">11 MB</div>
                                </div>
                            </div>
                            <button type="button" class="hdpfd-doc-download-btn" title="Download Document">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-linecap="round" stroke-linejoin="round"/>
                                    <polyline points="7 10 12 15 17 10" stroke-linecap="round" stroke-linejoin="round"/>
                                    <line x1="12" y1="15" x2="12" y2="3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>

                        <!-- Doc Item 3 -->
                        <div class="hdpfd-doc-item">
                            <div class="hdpfd-doc-left">
                                <div class="hdpfd-doc-icon-box">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-linecap="round" stroke-linejoin="round"/>
                                        <polyline points="14 2 14 8 20 8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="13" x2="8" y2="13" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="17" x2="8" y2="17" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <div class="hdpfd-doc-info">
                                    <div class="hdpfd-doc-name">Incident Reporting Procedure Document</div>
                                    <div class="hdpfd-doc-size">25 MB</div>
                                </div>
                            </div>
                            <button type="button" class="hdpfd-doc-download-btn" title="Download Document">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-linecap="round" stroke-linejoin="round"/>
                                    <polyline points="7 10 12 15 17 10" stroke-linecap="round" stroke-linejoin="round"/>
                                    <line x1="12" y1="15" x2="12" y2="3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="hdpfd-doc-list">
                        <!-- Doc Item 1 -->
                        <div class="hdpfd-doc-item">
                            <div class="hdpfd-doc-left">
                                <div class="hdpfd-doc-icon-box">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-linecap="round" stroke-linejoin="round"/>
                                        <polyline points="14 2 14 8 20 8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="13" x2="8" y2="13" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="17" x2="8" y2="17" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <div class="hdpfd-doc-info">
                                    <div class="hdpfd-doc-name">Formulation Standard Sheet v1.0</div>
                                    <div class="hdpfd-doc-size">15.4 MB</div>
                                </div>
                            </div>
                            <button type="button" class="hdpfd-doc-download-btn" title="Download Document">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-linecap="round" stroke-linejoin="round"/>
                                    <polyline points="7 10 12 15 17 10" stroke-linecap="round" stroke-linejoin="round"/>
                                    <line x1="12" y1="15" x2="12" y2="3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>

                        <!-- Doc Item 2 -->
                        <div class="hdpfd-doc-item">
                            <div class="hdpfd-doc-left">
                                <div class="hdpfd-doc-icon-box">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-linecap="round" stroke-linejoin="round"/>
                                        <polyline points="14 2 14 8 20 8" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="13" x2="8" y2="13" stroke-linecap="round" stroke-linejoin="round"/>
                                        <line x1="16" y1="17" x2="8" y2="17" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <div class="hdpfd-doc-info">
                                    <div class="hdpfd-doc-name">Technical Formulation Specification Guide</div>
                                    <div class="hdpfd-doc-size">8.2 MB</div>
                                </div>
                            </div>
                            <button type="button" class="hdpfd-doc-download-btn" title="Download Document">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-linecap="round" stroke-linejoin="round"/>
                                    <polyline points="7 10 12 15 17 10" stroke-linecap="round" stroke-linejoin="round"/>
                                    <line x1="12" y1="15" x2="12" y2="3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string activeTab = "po";

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private void DownloadAll()
    {
        // Trigger download action
    }
}
