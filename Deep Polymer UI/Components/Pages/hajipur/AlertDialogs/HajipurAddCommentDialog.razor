@using Microsoft.AspNetCore.Components

@if (IsOpen)
{
    <div class="dialog-overlay" @onclick="Close">
        <div class="dialog-card hajipur-comment-dialog" @onclick:stopPropagation>
            <!-- Header -->
            <div class="dialog-header">
                <h3 class="dialog-title">Add Comment</h3>
                <button type="button" class="dialog-close-btn" @onclick="Close" title="Close">&times;</button>
            </div>

            <!-- Body -->
            <div class="dialog-body">
                <div class="dialog-form-group">
                    <label class="dialog-label">
                        Comment <span style="color: #EF4444; font-weight: 700;">*</span>
                    </label>
                    <textarea class="dialog-textarea"
                              placeholder="Comment"
                              @bind="commentText"
                              rows="3"></textarea>
                </div>
            </div>

            <!-- Footer -->
            <div class="dialog-footer flex-end">
                <button type="button" class="dialog-btn cancel-hajipur" @onclick="Close">Cancel</button>
                <button type="button" class="dialog-btn submit-hajipur" @onclick="Submit">Submit</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<string> OnSubmitComment { get; set; }

    private string commentText = "";

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Submit()
    {
        if (OnSubmitComment.HasDelegate)
        {
            await OnSubmitComment.InvokeAsync(commentText);
        }
        commentText = "";
        await Close();
    }
}
