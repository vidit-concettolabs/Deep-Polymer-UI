@page "/hajipur/pmr-details/{PmrNo}"
@using Microsoft.AspNetCore.Components.Sections
@using Deep_Polymer_UI.Components.Pages.hajipur.AlertDialogs
@inject NavigationManager Navigation
@rendermode InteractiveServer

<!-- Inject ← Back into the main header slot -->
<SectionContent SectionName="header-back-slot">
    <a class="header-back-btn" href="hajipur/pmr-management">
        <svg viewBox="0 0 24 24">
            <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
    </a>
</SectionContent>

<div class="hdo-page">
    <!-- Top Summary Card -->
    <div class="hdo-card">
        <div class="hdo-card-title-row">
            <div class="hdo-title-wrap">
                <h2 class="hdo-card-title">Customer Details</h2>
                <button class="hdo-info-badge-btn" type="button" title="View PMR Details" @onclick="OpenDetailsDialog">
                    <img src="assets/image/information_icon_hajipur.svg" alt="Info" class="hdo-info-icon" />
                </button>
                <span class="hdo-badge-teal">Design Output</span>
            </div>
        </div>

        <div class="hdo-info-grid">
            <div class="hdo-info-item">
                <span class="hdo-info-label">PMR Number</span>
                <span class="hdo-info-value">@(string.IsNullOrEmpty(PmrNo) ? "PMR-001" : PmrNo)</span>
            </div>
            <div class="hdo-info-item">
                <span class="hdo-info-label">Colour Name</span>
                <span class="hdo-info-value">Ocean Blue - A</span>
            </div>
            <div class="hdo-info-item">
                <span class="hdo-info-label">Colour Code</span>
                <span class="hdo-info-value">OB-102</span>
            </div>
            <div class="hdo-info-item">
                <span class="hdo-info-label">Customer Name</span>
                <span class="hdo-info-value">Ramesh Patel</span>
            </div>
            <div class="hdo-info-item">
                <span class="hdo-info-label">Customer Sample Ref. No</span>
                <span class="hdo-info-value">BSPL/24/271-1/2/3/4/5/6</span>
            </div>
            <div class="hdo-info-item">
                <span class="hdo-info-label">Sample Type</span>
                <span class="hdo-info-value">Fabric</span>
            </div>
            <div class="hdo-info-item">
                <span class="hdo-info-label">Sample Received</span>
                <span class="hdo-info-value">07.08.2024</span>
            </div>
            <div class="hdo-info-item">
                <span class="hdo-info-label">LDR%</span>
                <span class="hdo-info-value">N/A</span>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs Bar -->
    <div class="hdo-tabs-bar">
        <button type="button" class="hdo-tab-btn @(activeTab == 0 ? "active" : "")" @onclick="() => SelectTab(0)">
            Product Details(Deep Polymers)
        </button>
        <button type="button" class="hdo-tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => SelectTab(1)">
            Technical Development Details
        </button>
    </div>

    <!-- Tab 0: Product Details (Deep Polymers) -->
    @if (activeTab == 0)
    {
        <div class="hdo-table-card">
            <div class="hdo-table-responsive">
                <table class="hdo-table">
                    <thead>
                        <tr>
                            <th style="width: 5%;">S. No.</th>
                            <th style="width: 18%;">Customer Sample(Ref. Name/Number)</th>
                            <th style="width: 15%;">Lab Ref. No.</th>
                            <th style="width: 12%;">Product Code</th>
                            <th style="width: 22%;">Product Name</th>
                            <th style="width: 8%;">% LDR</th>
                            <th style="width: 10%;">Sample Details</th>
                            <th style="width: 10%;">Sent Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 1; i <= 9; i++)
                        {
                            <tr>
                                <td>1</td>
                                <td>BSPL/24/271-1</td>
                                <td>PMR/H/0267A-1</td>
                                <td>BE20-1166</td>
                                <td><span class="hdo-product-pill">PET BKY Beige 20-1166</span></td>
                                <td>1.5%</td>
                                <td>3 POY</td>
                                <td>19-05-2026</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer Pagination Row -->
            <div class="hdo-pagination">
                <span class="hdo-pagination-info">Showing 1-10 of 12 list</span>
                <div class="hdo-pagination-controls">
                    <button type="button" class="hdo-page-nav-btn disabled">&lt;</button>
                    <button type="button" class="hdo-page-btn active">1</button>
                    <button type="button" class="hdo-page-btn">2</button>
                    <button type="button" class="hdo-page-nav-btn">&gt;</button>
                </div>
            </div>
        </div>
    }

    <!-- Tab 1: Technical Development Details -->
    @if (activeTab == 1)
    {
        <div class="hdo-table-card">
            <div class="hdo-table-responsive">
                <table class="hdo-tech-table">
                    <thead>
                        <tr>
                            <th style="width: 20%;">Type</th>
                            <th style="width: 40%;">Customer Details</th>
                            <th style="width: 40%;">Deep Planning</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="hdo-tech-type-cell">Polymer</td>
                            <td><input class="hdo-tech-input" value="Polyester (PET)" readonly /></td>
                            <td><input class="hdo-tech-input" value="Nylon (PA6)" readonly /></td>
                        </tr>
                        <tr>
                            <td class="hdo-tech-type-cell">POY Denier</td>
                            <td><input class="hdo-tech-input" value="150D" readonly /></td>
                            <td><input class="hdo-tech-input" value="200D" readonly /></td>
                        </tr>
                        <tr>
                            <td class="hdo-tech-type-cell">Final Denier</td>
                            <td><input class="hdo-tech-input" value="75D" readonly /></td>
                            <td><input class="hdo-tech-input" value="100D" readonly /></td>
                        </tr>
                        <tr>
                            <td class="hdo-tech-type-cell">Filaments</td>
                            <td><input class="hdo-tech-input" value="75D" readonly /></td>
                            <td><input class="hdo-tech-input" value="100D" readonly /></td>
                        </tr>
                        <tr>
                            <td class="hdo-tech-type-cell">Cross-Sec.</td>
                            <td><input class="hdo-tech-input" value="Round" readonly /></td>
                            <td><input class="hdo-tech-input" value="Trilobal" readonly /></td>
                        </tr>
                        <tr>
                            <td class="hdo-tech-type-cell">Yarn Structure</td>
                            <td><input class="hdo-tech-input" value="DTY" readonly /></td>
                            <td><input class="hdo-tech-input" value="FDY" readonly /></td>
                        </tr>
                        <tr>
                            <td class="hdo-tech-type-cell">Sample Requirement</td>
                            <td><input class="hdo-tech-input" value="500 kg" readonly /></td>
                            <td><input class="hdo-tech-input" value="250 kg" readonly /></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Action Buttons Footer -->
            <div class="hdo-tech-actions-bar">
                <div class="hdo-tech-actions-left">
                    <button type="button" class="hdo-btn-approved" @onclick="OpenSuccessDialog">Approved by Customer</button>
                    <button type="button" class="hdo-btn-reject" @onclick="OpenCommentDialog">Reject By Customer</button>
                </div>
                <div class="hdo-tech-actions-right">
                    <button type="button" class="hdo-btn-email" @onclick="OpenSuccessDialog">Email to Customer</button>
                </div>
            </div>
        </div>
    }

    <!-- Dialogs -->
    <HajipurPmrDetailsDialog @bind-IsOpen="showDetailsDialog" PmrNo="@PmrNo" />
    <HajipurAddCommentDialog @bind-IsOpen="showCommentDialog" OnSubmitComment="HandleCommentSubmitted" />
    <HajipurPmrSubmittedSuccessDialog @bind-IsOpen="showSuccessDialog" OnOk="HandleSuccessOk" />
</div>

@code {
    [Parameter] public string PmrNo { get; set; } = "PMR-001";
    [Parameter] public EventCallback OnBack { get; set; }

    private int activeTab = 0;
    private bool showDetailsDialog = false;
    private bool showCommentDialog = false;
    private bool showSuccessDialog = false;

    private void SelectTab(int index)
    {
        activeTab = index;
    }

    private void OpenDetailsDialog()
    {
        showDetailsDialog = true;
    }

    private void OpenCommentDialog()
    {
        showCommentDialog = true;
    }

    private void OpenSuccessDialog()
    {
        showSuccessDialog = true;
    }

    private void HandleCommentSubmitted(string comment)
    {
        // Handle comment submission
    }

    private void HandleSuccessOk()
    {
        Navigation.NavigateTo("/hajipur/pmr-management");
    }

    private async Task HandleBack()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
        else
        {
            Navigation.NavigateTo("/hajipur/pmr-management");
        }
    }
}
