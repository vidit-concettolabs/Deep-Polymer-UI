@if (IsOpen)
{
    <div class="hpmr-dialog-overlay" @onclick="Close">
        <div class="hpmr-dialog-card" @onclick:stopPropagation="true">

            <!-- Header -->
            <div class="hpmr-dialog-header">
                <h3 class="hpmr-dialog-title">PMR Details - #@(string.IsNullOrEmpty(PmrNo) ? "1" : PmrNo)</h3>
                <button class="hpmr-dialog-close-btn" type="button" @onclick="Close">&times;</button>
            </div>

            <!-- Body (Scrollable) -->
            <div class="hpmr-dialog-body">

                <!-- 4-Column Grid -->
                <div class="hpmr-specs-grid">

                    <!-- Row 1 -->
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Customer Color Ref. Name/Number</span>
                        <span class="hpmr-spec-value">Ocean Blue Ref-A1</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Color Name</span>
                        <span class="hpmr-spec-value">Ocean Blue</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Color Code</span>
                        <span class="hpmr-spec-value">OB-102</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Sample Color Name</span>
                        <span class="hpmr-spec-value">Ocean Blue Sample</span>
                    </div>

                    <!-- Row 2 -->
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Sample Type</span>
                        <span class="hpmr-spec-value">Fabric</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">%LDR</span>
                        <span class="hpmr-spec-value">3%</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">No of Cones Reqd</span>
                        <span class="hpmr-spec-value">5</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Cone Weight</span>
                        <span class="hpmr-spec-value">1.2 KG</span>
                    </div>

                    <!-- Row 3 -->
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">No of Card Strip Required</span>
                        <span class="hpmr-spec-value">2</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">No of Dev Option</span>
                        <span class="hpmr-spec-value">1</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Specific Requirement</span>
                        <span class="hpmr-spec-value">UV Resistance Required</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Functional prop = FR/Anti-Microbial</span>
                        <span class="hpmr-spec-value">FR (Flame Retardant)</span>
                    </div>

                    <!-- Row 4 -->
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Fastness Required</span>
                        <span class="hpmr-spec-value">Grade 4-5</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">End Use</span>
                        <span class="hpmr-spec-value">Automotive Upholstery</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Market</span>
                        <span class="hpmr-spec-value">Domestic</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Spectro Needed</span>
                        <div class="hpmr-radio-group">
                            <label class="hpmr-radio-label">
                                <input type="radio" name="spectroNeeded_@UniqueId" value="Yes" checked />
                                Yes
                            </label>
                            <label class="hpmr-radio-label">
                                <input type="radio" name="spectroNeeded_@UniqueId" value="No" />
                                No
                            </label>
                        </div>
                    </div>

                    <!-- Row 5 -->
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Light Source</span>
                        <span class="hpmr-spec-value">D65</span>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Azo Free</span>
                        <div class="hpmr-radio-group">
                            <label class="hpmr-radio-label">
                                <input type="radio" name="azoFree_@UniqueId" value="Yes" checked />
                                Yes
                            </label>
                            <label class="hpmr-radio-label">
                                <input type="radio" name="azoFree_@UniqueId" value="No" />
                                No
                            </label>
                        </div>
                    </div>
                    <div class="hpmr-spec-item">
                        <span class="hpmr-spec-label">Remark</span>
                        <span class="hpmr-spec-value">Standard testing approved</span>
                    </div>
                    <div class="hpmr-spec-item"></div>

                </div>

                <!-- Bottom Table Section -->
                <div class="hpmr-planning-table-wrapper">
                    <table class="hpmr-planning-table">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Type</th>
                                <th style="width: 37.5%;">Customer Details</th>
                                <th style="width: 37.5%;">Deep Planning</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Polymer</td>
                                <td>
                                    <div class="hpmr-table-select-wrapper">
                                        <select class="hpmr-table-select">
                                            <option selected disabled>Select Polymer</option>
                                            <option>PET Polymer</option>
                                            <option>PBT Polymer</option>
                                            <option>Nylon Polymer</option>
                                        </select>
                                        <span class="hpmr-table-select-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="hpmr-table-select-wrapper">
                                        <select class="hpmr-table-select">
                                            <option selected disabled>Select Polymer</option>
                                            <option>PET Polymer</option>
                                            <option>PBT Polymer</option>
                                            <option>Nylon Polymer</option>
                                        </select>
                                        <span class="hpmr-table-select-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>POY Den/Filaments</td>
                                <td>
                                    <input type="text" class="hpmr-table-input" placeholder="Enter POY Den/Filaments" />
                                </td>
                                <td>
                                    <input type="text" class="hpmr-table-input" placeholder="Enter POY Den/Filaments" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

            <!-- Footer -->
            <div class="hpmr-dialog-footer">
                <button class="hpmr-dialog-footer-close-btn" type="button" @onclick="Close">Close</button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string PmrNo { get; set; } = "1";

    private string UniqueId = Guid.NewGuid().ToString("N");

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
