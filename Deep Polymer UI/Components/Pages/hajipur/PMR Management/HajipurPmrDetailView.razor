@using Microsoft.AspNetCore.Components.Sections

<!-- Inject ← Back into the main header slot -->
@if (OnBack.HasDelegate)
{
    <SectionContent SectionName="header-back-slot">
        <button class="header-back-btn" type="button" @onclick="OnBack">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Back
        </button>
    </SectionContent>
}

<div class="hpdv-page">

    <!-- LEFT + RIGHT two-column grid -->
    <div class="hpdv-grid">

        <!-- ===== LEFT COLUMN ===== -->
        <div class="hpdv-left-col">

            <!-- PMR Information Card -->
            <div class="hpdv-card">
                <div class="hpdv-card-title-row">
                    <h2 class="hpdv-card-title">PMR Information</h2>
                    <button class="hpdv-info-badge-btn" type="button" title="View PMR Details" @onclick="OpenDetailsDialog">
                        <img src="assets/image/information_icon_hajipur.svg" alt="Info" class="hpdv-info-icon" />
                    </button>
                </div>

                <div class="hpdv-info-grid">
                    <div class="hpdv-info-item">
                        <span class="hpdv-info-label">PMR Number</span>
                        <span class="hpdv-info-value">@(string.IsNullOrEmpty(PmrNo) ? "PMR-001" : PmrNo)</span>
                    </div>
                    <div class="hpdv-info-item">
                        <span class="hpdv-info-label">Customer Name</span>
                        <span class="hpdv-info-value">Ramesh Patel</span>
                    </div>
                    <div class="hpdv-info-item">
                        <span class="hpdv-info-label">Colour Name</span>
                        <span class="hpdv-info-value">Ocean Blue - A</span>
                    </div>
                    <div class="hpdv-info-item">
                        <span class="hpdv-info-label">Colour Code</span>
                        <span class="hpdv-info-value">OB-102</span>
                    </div>
                    <div class="hpdv-info-item">
                        <span class="hpdv-info-label">City</span>
                        <span class="hpdv-info-value">Ahmedabad</span>
                    </div>
                    <div class="hpdv-info-item">
                        <span class="hpdv-info-label">Received From</span>
                        <span class="hpdv-info-value">OB-102</span>
                    </div>
                    <div class="hpdv-info-item">
                        <span class="hpdv-info-label">Region</span>
                        <span class="hpdv-info-value">Gujarat</span>
                    </div>
                    <div class="hpdv-info-item">
                        <span class="hpdv-info-label">Sample Request Date</span>
                        <span class="hpdv-info-value">07.08.2024</span>
                    </div>
                </div>
            </div>

            <!-- Raw Material Weights Card -->
            <div class="hpdv-card hpdv-rm-card">
                <h2 class="hpdv-card-title">Raw Material Weights</h2>
                <p class="hpdv-card-subtitle">Add and manage raw material weights for the selected PMR.</p>

                <div class="hpdv-rm-table-wrap">
                    <table class="hpdv-rm-table">
                        <colgroup>
                            <col class="hpdv-col-material" />
                            <col class="hpdv-col-pct" />
                            <col class="hpdv-col-price" />
                            <col class="hpdv-col-cost" />
                        </colgroup>
                        <thead>
                            <tr class="hpdv-tr-head">
                                <th class="hpdv-th hpdv-th-left">Raw Material</th>
                                <th class="hpdv-th hpdv-th-center">
                                    Percentage
                                    <img src="assets/image/pencil.svg" class="hpdv-edit-icon" alt="Edit" />
                                </th>
                                <th class="hpdv-th hpdv-th-center">RM Price</th>
                                <th class="hpdv-th hpdv-th-center">RM Cost/Kg</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="hpdv-tr">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Titanium Dioxide</option>
                                            <option>Carbon Black</option>
                                            <option>Zinc Oxide</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="3%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="180.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">3960.00</span></td>
                            </tr>
                            <tr class="hpdv-tr">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Titanium Dioxide</option>
                                            <option>Carbon Black</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="3%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="150.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">180.00</span></td>
                            </tr>
                            <tr class="hpdv-tr">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Titanium Dioxide</option>
                                            <option>Carbon Black</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="3%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="180.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">3960.00</span></td>
                            </tr>
                            <tr class="hpdv-tr">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Titanium Dioxide</option>
                                            <option>Carbon Black</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="3%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="180.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">3960.00</span></td>
                            </tr>
                            <tr class="hpdv-tr">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Zinc Oxide</option>
                                            <option>Titanium Dioxide</option>
                                            <option>Carbon Black</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="4%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="210.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">840.00</span></td>
                            </tr>
                            <tr class="hpdv-tr">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Calcium Carbonate</option>
                                            <option>Zinc Oxide</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="2%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="95.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">190.00</span></td>
                            </tr>
                            <tr class="hpdv-tr">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Barium Sulfate</option>
                                            <option>Titanium Dioxide</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="5%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="160.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">800.00</span></td>
                            </tr>
                            <tr class="hpdv-tr">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Carbon Black</option>
                                            <option>Titanium Dioxide</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="3%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="175.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">525.00</span></td>
                            </tr>
                            <tr class="hpdv-tr hpdv-tr-last">
                                <td class="hpdv-td">
                                    <div class="hpdv-select-wrap">
                                        <select class="hpdv-select">
                                            <option>Titanium Dioxide</option>
                                            <option>Carbon Black</option>
                                        </select>
                                        <span class="hpdv-chevron">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                        </span>
                                    </div>
                                </td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="3%" /></td>
                                <td class="hpdv-td hpdv-td-center"><input type="text" class="hpdv-plain-val" value="150.00" /></td>
                                <td class="hpdv-td hpdv-td-center"><span class="hpdv-rm-cost-pill">180.00</span></td>
                            </tr>
                        </tbody>
                    </table>

                </div><!-- /.hpdv-rm-table-wrap -->

                <!-- Total Row: full card width, separate grey separator -->
                <div class="hpdv-total-row">
                    <span class="hpdv-total-label">Total Weight(kgs) &amp; Raw Material Cost(&#8377;):</span>
                    <div class="hpdv-total-pills">
                        <span class="hpdv-total-pill-grey">24.00</span>
                        <span class="hpdv-rm-cost-pill">3960.00</span>
                    </div>
                </div>

            </div><!-- /.hpdv-rm-card -->

        </div>

        <!-- ===== RIGHT COLUMN: Cost Summary ===== -->
        <div class="hpdv-right-col">
            <div class="hpdv-card hpdv-cost-card">
                <div class="hpdv-card-title-row hpdv-cost-title-row">
                    <h2 class="hpdv-card-title">Cost Summary</h2>
                    <div class="hpdv-cost-action-icons">
                        <button type="button" class="hpdv-icon-btn" title="Revised Rate" @onclick="OpenRevisedRateDialog">
                            <img src="assets/image/revised_rate_icon.svg" alt="R" class="hpdv-action-icon" />
                        </button>
                        <button type="button" class="hpdv-icon-btn" title="Negotiation" @onclick="OpenNegotiationDialog">
                            <img src="assets/image/negotiation_icon.svg" alt="N" class="hpdv-action-icon" />
                        </button>
                    </div>

                    <!-- Revised Rate Popover (anchored under R/N icons) -->
                    <HajipurRevisedRateDialog @bind-IsOpen="showRevisedRateDialog" />
                </div>
                <p class="hpdv-card-subtitle">Review the final product costing and additional charges before submission.</p>

                <div class="hpdv-cost-list">
                    <div class="hpdv-cost-row">
                        <span class="hpdv-cost-label">RMC:</span>
                        <input type="text" class="hpdv-cost-input" value="20" />
                    </div>
                    <div class="hpdv-cost-row">
                        <span class="hpdv-cost-label">Opp Cost(Rs/kg):</span>
                        <span class="hpdv-cost-pill-blue">15503.84</span>
                    </div>
                    <div class="hpdv-cost-row">
                        <span class="hpdv-cost-label">Profit/Margin:</span>
                        <input type="text" class="hpdv-cost-plain-val" value="310.15" />
                    </div>
                    <div class="hpdv-cost-row">
                        <span class="hpdv-cost-label">Min price:</span>
                        <input type="text" class="hpdv-cost-plain-val" value="15000.00" />
                    </div>
                    <div class="hpdv-cost-row">
                        <span class="hpdv-cost-label">Quoted Price:</span>
                        <input type="text" class="hpdv-cost-plain-val" value="15000.00" />
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- PMR Details Dialog (opened via info icon) -->
    <HajipurPmrDetailsDialog @bind-IsOpen="showDetailsDialog" PmrNo="@PmrNo" />

    <!-- Negotiation Dialog (opened via N icon) -->
    <HajipurNegotiationDialog @bind-IsOpen="showNegotiationDialog" />

    <!-- Bottom white card with Submit button (in page flow, not sticky) -->
    <div class="hpdv-footer-card">
        <button class="hpdv-submit-btn" type="button">Submit to Production Head</button>
    </div>

</div>

@code {
    [Parameter] public string PmrNo { get; set; } = "PMR-001";
    [Parameter] public EventCallback OnBack { get; set; }

    private bool showDetailsDialog = false;
    private bool showRevisedRateDialog = false;
    private bool showNegotiationDialog = false;

    private void OpenDetailsDialog()
    {
        showDetailsDialog = true;
    }

    private void OpenRevisedRateDialog()
    {
        showRevisedRateDialog = true;
    }

    private void OpenNegotiationDialog()
    {
        showNegotiationDialog = true;
    }
}
