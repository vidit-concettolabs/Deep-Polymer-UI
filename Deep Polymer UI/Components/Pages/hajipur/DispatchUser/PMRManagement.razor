        new DispatchItem { PmrNo = "PMR-006", CustomerName = "Neha Gupta", ColourName = "Lavender Purple - L", ColourCode = "NB-430", SampleType = "Textile Type", SampleSentDate = "10-10-2026", RequestStatus = "Invoice Sent" },
