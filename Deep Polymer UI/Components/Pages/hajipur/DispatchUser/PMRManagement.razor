        new DispatchItem { PmrNo = "PMR-008", CustomerName = "Priya Sharma", ColourName = "Mint Green - M", ColourCode = "NB-442", SampleType = "Weave", SampleSentDate = "29-11-2026", RequestStatus = "Invoice Sent" },
        new DispatchItem { PmrNo = "PMR-009", CustomerName = "Vikram Desai", ColourName = "Golden Yellow - G", ColourCode = "NB-450", SampleType = "Pattern", SampleSentDate = "12-12-2026", RequestStatus = "Completed" },
        new DispatchItem { PmrNo = "PMR-010", CustomerName = "Anita Rao", ColourName = "Blush Pink - B", ColourCode = "NB-455", SampleType = "Texture", SampleSentDate = "20-12-2026", RequestStatus = "Invoice Sent" },
