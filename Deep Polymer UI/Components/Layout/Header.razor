<header class="header-container">
    <div class="header-left">
        <button class="hamburger-btn" type="button" title="Toggle Navigation">
            <svg viewBox="0 0 24 24">
                <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
            </svg>
        </button>
        <SectionOutlet SectionName="header-back-slot" />
    </div>
    
    <div class="header-right">
        <div class="location-indicator">
            <span class="location-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            <span>@(ColorConstant.BranchFlag == 2 ? "Hajipur" : "Santej")</span>
        </div>
        
        <button class="notification-btn" type="button" title="Notifications">
            <svg viewBox="0 0 24 24">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9zm-6 13a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="notification-badge">1</span>
        </button>
        
        <button class="user-profile-btn" type="button" title="User Menu">
            <div class="avatar-circle">DH</div>
            <div class="user-info">
                <span class="user-name">Denis Harvey</span>
                <span class="user-role">Admin</span>
            </div>
            <span class="profile-arrow">
                <svg viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </button>
    </div>
</header>

@using DeepPolymer.Constants
@using Microsoft.AspNetCore.Components.Sections
