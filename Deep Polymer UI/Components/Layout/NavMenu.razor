@using DeepPolymer.Constants
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@implements IDisposable

<div class="sidebar-container @(ColorConstant.BranchFlag == 2 ? "hajipur-nav" : "")">
    <div class="logo-area">
        <img src="@ColorConstant.LogoUrl" alt="DEEP MASTERBATCHES" class="logo-img" />
    </div>

    <div class="menu-items-wrapper">

        <!-- PMR Management -->
        <a class="menu-item-link @(IsActive(PmrHref) ? "nav-active" : "")"
           href="@PmrHref">
            <span class="menu-icon">
                <img src="assets/image/pmr_management.svg" class="nav-icon" alt="PMR Management" />
            </span>
            <span class="menu-text">PMR Management</span>
        </a>

        <!-- Master's -->
        <a class="menu-item-link @(IsActive("masters") ? "nav-active" : "")"
           href="masters">
            <span class="menu-icon">
                <img src="assets/image/master.svg" class="nav-icon" alt="Master's" />
            </span>
            <span class="menu-text">Master's</span>
        </a>

        <!-- Manage Locations -->
        <a class="menu-item-link @(IsActive("locations") ? "nav-active" : "")"
           href="locations">
            <span class="menu-icon">
                <img src="assets/image/manage_location.svg" class="nav-icon" alt="Manage Locations" />
            </span>
            <span class="menu-text">Manage Locations</span>
        </a>

        <!-- Manage IP Addresses -->
        <a class="menu-item-link @(IsActive("ip-addresses") ? "nav-active" : "")"
           href="ip-addresses">
            <span class="menu-icon">
                <img src="assets/image/manage_ip.svg" class="nav-icon" alt="Manage IP Addresses" />
            </span>
            <span class="menu-text">Manage IP Addresses</span>
        </a>

        <!-- Role Based Access -->
        <a class="menu-item-link @(IsActive("role-access") ? "nav-active" : "")"
           href="role-access">
            <span class="menu-icon">
                <img src="assets/image/role_based_acess.svg" class="nav-icon" alt="Role Based Access" />
            </span>
            <span class="menu-text">Role Based Access</span>
        </a>

        <!-- User Management -->
        <a class="menu-item-link @(IsActive("users") ? "nav-active" : "")"
           href="users">
            <span class="menu-icon">
                <img src="assets/image/user_management.svg" class="nav-icon" alt="User Management" />
            </span>
            <span class="menu-text">User Management</span>
        </a>

        @if (ColorConstant.BranchFlag != 2)
        {
            <!-- Reports (collapsible) — active when any sub-route is active -->
            <button class="menu-item-link menu-collapse-btn @(IsReportsActive ? "nav-active" : "")"
                    type="button" @onclick="ToggleReports">
                <span class="menu-icon">
                    <img src="assets/image/reports.svg" class="nav-icon" alt="Reports" />
                </span>
                <span class="menu-text">Reports</span>
                <span class="expand-icon @(reportsOpen ? "expanded" : "")">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </button>

            @if (reportsOpen)
            {
                <div class="menu-sub-items">
                    <a class="menu-sub-link @(IsActive("reports/pmr") ? "menu-sub-active" : "")"
                       href="reports/pmr">PMR Reports</a>
                    <a class="menu-sub-link @(IsActive("reports/color-price-list") ? "menu-sub-active" : "")"
                       href="reports/color-price-list">Color Wise Price List</a>
                </div>
            }

            <!-- Settings -->
            <a class="menu-item-link @(IsActive("settings") ? "nav-active" : "")"
               href="settings">
                <span class="menu-icon">
                    <img src="assets/image/settings.svg" class="nav-icon" alt="Settings" />
                </span>
                <span class="menu-text">Settings</span>
            </a>
        }

    </div>
</div>

@code {
    private bool reportsOpen = false;

    private string PmrHref => ColorConstant.BranchFlag == 2
        ? "hajipur/pmr-management"
        : "santej/pmr-management";

    private bool IsActive(string href)
    {
        var uri = NavigationManager.Uri;
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        var currentPath = uri.StartsWith(baseUri)
            ? uri.Substring(baseUri.Length).TrimStart('/').ToLowerInvariant()
            : NavigationManager.ToBaseRelativePath(uri).TrimStart('/').ToLowerInvariant();

        href = href.TrimStart('/').ToLowerInvariant();

        if (string.IsNullOrEmpty(href))
            return string.IsNullOrEmpty(currentPath);

        return currentPath == href || currentPath.StartsWith(href + "/");
    }

    private bool IsReportsActive =>
        IsActive("reports/pmr") || IsActive("reports/color-price-list");

    private void ToggleReports()
    {
        if (!IsReportsActive)
        {
            reportsOpen = true;
            NavigationManager.NavigateTo("reports/pmr");
        }
        else
        {
            reportsOpen = !reportsOpen;
        }
    }

    protected override void OnInitialized()
    {
        if (IsReportsActive) reportsOpen = true;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (IsReportsActive) reportsOpen = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
